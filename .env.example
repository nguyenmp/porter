# Copy to `.env` and complete; never commit real keys.

# Server (owns the LLM connection + tool execution). Run with `make server`.
# PORTER_ADDR is where the server listens. In the container workflow it must
# bind 0.0.0.0 so the REPL client container can reach it on the bridge network.
PORTER_ADDR=0.0.0.0:8787
PORTER_BASE_URL=https://api.openai.com/v1
PORTER_MODEL=gpt-4o-mini
PORTER_API_KEY=

# Optional: which endpoints the model may use. One model often has many
# endpoints: other providers serving it, at other precisions. This setting
# pins the ones you want. Two forms:
#
#   A provider slug or comma-separated list. Pins those endpoints and turns
#   fallbacks off, so a request fails instead of going elsewhere:
#     PORTER_PROVIDER=deepinfra/fp8
#
#   A JSON object with the gateway's routing fields, for anything else:
#     PORTER_PROVIDER={"only":["deepinfra/fp8"],"allow_fallbacks":false}
#
# Fields: order, only, ignore, allow_fallbacks, require_parameters,
# quantizations, sort, data_collection, zdr, enforce_distillable_text,
# preferred_min_throughput, preferred_max_latency, max_price. A misspelled
# field stops the server at startup instead of being ignored. Leave it unset
# and the gateway routes as it did before.
# PORTER_PROVIDER=

# Client (REPL / one-shot). Run with `make repl` or `make run PROMPT=...`.
# Defaults to the server container name on the bridge network.
PORTER_SERVER_URL=http://porter-server:8787

# Optional: write the event stream + progress lines to this file instead of
# stderr, to keep the REPL terminal quiet (e.g. inside docker).
# PORTER_LOG=porter.log

# Optional HTTP Basic Auth credentials sent by the client on every request, so
# a reverse proxy in front of the server (e.g. Caddy basic_auth) can
# authenticate it. The server itself does not check them.
# PORTER_AUTH_USERNAME=porter
# PORTER_AUTH_PASSWORD=

# Optional: resume an existing session id instead of creating a new one
# (same as `porter --session <id>`).
# PORTER_SESSION=

# Execution host agent (run with `make host` on the machine whose commands you
# want to run, e.g. the laptop). The host's default working directory is the
# directory `make host` runs from; a chat can request a different one when
# it's created. PORTER_HOST_ID overrides the hostname the agent registers as.
# PORTER_HOST_ID=macbook

# Worktree sandboxes: when a chat is created "on" this host, the web UI offers
# the git repositories discovered under the host's home directory (each folder
# with a .git), and the chosen repo gets a git worktree sandbox — a fresh
# branch porter/<id> based at the requested branch — so many chats can work on
# the same repo without trampling each other. Repo names are resolved from the
# host's home directory (matching the discovery scan), so a bare name like
# "porter" means ~/porter. Sandboxes live in ~/.porter/sandboxes (not
# configurable). Archiving a sandboxed chat removes its worktree. A host
# restart never wipes sandboxes: on reconnect the host offers the folders it
# found to the server, which reconnects each one to its chat (so the chat
# resumes in the same sandbox) and refuses the dead ones, which the host then
# removes — deleting worktree folders but keeping their porter/<id> branches.

