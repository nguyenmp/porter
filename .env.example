# Copy to `.env` and complete; never commit real keys.
PORTER_BASE_URL=https://api.openai.com/v1
PORTER_MODEL=gpt-4o-mini
PORTER_API_KEY=

# Optional: write the structured event stream + progress lines to this file
# instead of stderr, to keep the REPL terminal quiet (e.g. inside docker).
# PORTER_LOG=porter.log
