# Copy to `.env` and complete; never commit real keys.

# Server (owns the LLM connection + tool execution). Run with `make server`.
# PORTER_ADDR is where the server listens. In the container workflow it must
# bind 0.0.0.0 so the REPL client container can reach it on the bridge network.
PORTER_ADDR=0.0.0.0:8787
PORTER_BASE_URL=https://api.openai.com/v1
PORTER_MODEL=gpt-4o-mini
PORTER_API_KEY=

# Client (REPL / one-shot). Run with `make repl` or `make run PROMPT=...`.
# Defaults to the server container name on the bridge network.
PORTER_SERVER_URL=http://porter-server:8787

# Optional: write the event stream + progress lines to this file instead of
# stderr, to keep the REPL terminal quiet (e.g. inside docker).
# PORTER_LOG=porter.log

# Optional HTTP Basic Auth credentials sent by the client on every request, so
# a reverse proxy in front of the server (e.g. Caddy basic_auth) can
# authenticate it. The server itself does not check them.
# PORTER_AUTH_USERNAME=porter
# PORTER_AUTH_PASSWORD=