{{define "content"}}
<div id="app" data-session="{{.Session}}">
	<nav class="sidebar">
		<span class="brand">porter</span>
		<form class="new-chat" hx-post="/api/sessions" hx-swap="none" hx-on::after-request="onNewChat(event)">
			<button type="submit">+ New chat</button>
		</form>
		<ul id="session-list" hidden></ul>
	</nav>
	<main class="main">
		{{if .Session}}
		<div id="chat"
		  hx-get="/api/sessions/{{.Session}}/view"
		  hx-trigger="load"
		  hx-swap="innerHTML">
		</div>
		<div id="sse-processor"
		     hx-ext="sse"
		     sse-connect="/api/sessions/{{.Session}}/stream?since={{.Seq}}"
		     sse-swap="message_committed,llm,tool_result,turn_completed"
		     hx-swap="none"
		     hx-on:htmx:sse-message="sseMessage(event)">
		</div>
		<form hx-post="/api/sessions/{{.Session}}/messages"
		      hx-target="#chat"
		      hx-swap="none"
		      class="msg-form">
			<input type="text" name="content" placeholder="Type a message…" autocomplete="off" autofocus>
			<button type="submit">Send</button>
		</form>
		{{else}}
		<div class="empty-state">
			<p>No session selected.</p>
			<p>Start a new chat to begin.</p>
		</div>
		{{end}}
	</main>
</div>
<script>
(function() {
  // New chat button: POST /api/sessions, then follow the freshly created
  // session id to its chat page. All client-side; no server change needed.
  window.onNewChat = function(evt) {
    if (evt.detail.xhr.status < 200 || evt.detail.xhr.status >= 300) return;
    try {
      const id = JSON.parse(evt.detail.xhr.responseText).id;
      if (id) window.location = '/?session=' + encodeURIComponent(id);
    } catch (e) {}
  };

  // --- Client-side session registry (Step 4) ---
  // No server list endpoint yet; the browser remembers the sessions it has
  // created or visited in localStorage and renders them in the sidebar. This is
  // a placeholder until the server grows a list endpoint / SQLite persistence.
  const SESSIONS_KEY = 'porter.sessions';

  function loadSessionIds() {
    try {
      const raw = localStorage.getItem(SESSIONS_KEY);
      const arr = raw ? JSON.parse(raw) : [];
      return Array.isArray(arr) ? arr : [];
    } catch (e) { return []; }
  }

  function saveSessionIds(ids) {
    try { localStorage.setItem(SESSIONS_KEY, JSON.stringify(ids)); } catch (e) {}
  }

  function recordSession(id) {
    const ids = loadSessionIds().filter(x => x !== id);
    ids.unshift(id);
    saveSessionIds(ids);
    renderSidebar(id);
  }

  function renderSidebar(activeId) {
    const listEl = document.getElementById('session-list');
    if (!listEl) return;
    const ids = loadSessionIds();
    listEl.innerHTML = '';
    for (const id of ids) {
      const a = document.createElement('a');
      a.href = '/?session=' + encodeURIComponent(id);
      a.textContent = id;
      a.className = 'session-link' + (id === activeId ? ' active' : '');
      listEl.appendChild(a);
    }
    listEl.hidden = ids.length === 0;
  }

  // Register the active session (if any) on load so a fresh visit shows up in
  // the sidebar, and render the list (empty state has no active session).
  const app = document.getElementById('app');
  const activeSession = app ? app.dataset.session || '' : '';
  if (activeSession) {
    recordSession(activeSession);
  } else {
    renderSidebar(null);
  }

  const chat = document.getElementById('chat');
  const form = document.querySelector('.msg-form');
  const input = form ? form.querySelector('input[name="content"]') : null;

  // Track the currently streaming assistant message and reasoning block so
  // deltas can append in place instead of creating new elements each time.
  let currentAssistant = null;
  let currentReasoning = null;

  // A tool result is broadcast twice per run: once live as tool_result, then
  // again as a committed role-"tool" message (the copy that replays after a
  // reconnect). Remember which calls we've already shown live so the committed
  // copy only renders when there was no live one (i.e. on replay).
  const renderedToolResults = new Set();
  // Committed messages are replayed by the server whenever the SSE stream
  // reconnects from its original `since` (the url is fixed at page load).
  // Remember which commit seqs we've rendered so a replay doesn't duplicate
  // messages that are already in the DOM.
  const renderedCommits = new Set();

  function escapeHTML(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Returns true if the chat is scrolled to (or within `threshold` px of) the
  // bottom. Used to decide whether to auto-follow new content: if the user has
  // scrolled up to read earlier messages, don't yank the view back down.
  function isNearBottom(el, threshold) {
    const t = threshold || 40;
    return el.scrollHeight - el.scrollTop - el.clientHeight <= t;
  }

  function appendMessage(role, html) {
    const div = document.createElement('div');
    div.className = 'msg msg-' + role;
    div.innerHTML = '<span class="msg-role">' + role + '</span><div class="msg-content">' + html + '</div>';
    chat.appendChild(div);
    return div;
  }

  function ensureAssistant() {
    if (!currentAssistant) {
      currentAssistant = appendMessage('assistant', '');
      currentReasoning = null;
    }
    return currentAssistant.querySelector('.msg-content');
  }

  function ensureReasoning() {
    if (!currentReasoning) {
      currentReasoning = document.createElement('div');
      currentReasoning.className = 'reasoning';
      ensureAssistant().before(currentReasoning);
    }
    return currentReasoning;
  }

  function renderToolCalls(calls) {
    if (!calls || calls.length === 0) return '';
    let html = '';
    for (const call of calls) {
      html += '<details class="tool-call"><summary>' + escapeHTML(call.function.name) + '</summary>' +
              '<pre><code>' + escapeHTML(call.function.arguments) + '</code></pre></details>';
    }
    return html;
  }

  function finalizeAssistant(m, html) {
    // Replace the live text with the committed version (server-rendered
    // markdown when supplied, escaped plaintext otherwise) and ensure tool
    // calls are present. html is carried on the message_committed envelope so
    // the committed copy matches exactly what /view renders on reload — single
    // source of truth = goldmark on the server. The fallback only fires when
    // no rendered copy is supplied (e.g. an older server or empty content).
    const contentHTML = html || (m.content ? escapeHTML(m.content).replace(/\n/g, '<br>') : '');
    // Reasoning was already rendered live, chunk by chunk, when it streamed
    // (currentReasoning is set until here). A committed copy that arrives with
    // no live stream (SSE replay after a reconnect, or a reload) carries
    // reasoning on the message itself — render it now so history and the live
    // view never differ.
    const hadLiveReasoning = currentReasoning !== null;
    let div;
    if (currentAssistant) {
      div = currentAssistant;
      currentAssistant.querySelector('.msg-content').innerHTML = contentHTML;
      // Remove any stale tool-call details so we can re-render from the commit.
      div.querySelectorAll('.tool-call').forEach(el => el.remove());
    } else {
      // No live copy (replay/history): render a fresh element with the full
      // committed content rather than an empty bubble.
      div = appendMessage('assistant', contentHTML);
    }
    if (m.reasoning && !hadLiveReasoning) {
      const r = document.createElement('div');
      r.className = 'reasoning';
      r.innerHTML = escapeHTML(m.reasoning).replace(/\n/g, '<br>');
      div.before(r);
    }
    if (m.tool_calls) {
      div.insertAdjacentHTML('beforeend', renderToolCalls(m.tool_calls));
    }
    currentAssistant = null;
    currentReasoning = null;
  }

  window.sseMessage = function(evt) {
    const env = JSON.parse(evt.detail.data);
    // Remember whether the user was already pinned to the bottom before this
    // update touches the DOM. If they've scrolled up to read something, we
    // should not yank them back down as new content arrives.
    const wasAtBottom = isNearBottom(chat);
    switch (env.kind) {
      case 'message_committed':
        const m = env.message;
        // Skip a replayed commit we've already rendered (SSE reconnect replays
        // from the original `since`).
        if (env.seq && renderedCommits.has(env.seq)) break;
        if (env.seq) renderedCommits.add(env.seq);
        if (m.role === 'user') {
          currentAssistant = null;
          currentReasoning = null;
          appendMessage('user', escapeHTML(m.content).replace(/\n/g, '<br>'));
        } else if (m.role === 'assistant') {
          finalizeAssistant(m, env.message_html);
        } else if (m.role === 'tool') {
          currentAssistant = null;
          currentReasoning = null;
          // The live tool_result already rendered this run; only render the
          // committed copy when it arrives alone (replay), which carries no
          // tool name.
          if (renderedToolResults.has(m.tool_call_id)) {
            break;
          }
          const details = document.createElement('details');
          details.className = 'tool-result';
          details.innerHTML = '<summary>tool result</summary><pre><code>' + escapeHTML(m.content).replace(/\n/g, '<br>') + '</code></pre>';
          chat.appendChild(details);
        }
        break;
      case 'llm':
        const ev = env.event;
        if (!ev) break;
        if (ev.type === 'message_delta') {
          ensureAssistant().insertAdjacentText('beforeend', ev.delta);
        } else if (ev.type === 'reasoning_delta') {
          ensureReasoning().insertAdjacentHTML('beforeend', escapeHTML(ev.reasoning).replace(/\n/g, '<br>'));
        } else if (ev.type === 'tool_call') {
          // Streamed tool calls are rendered live; finalizeAssistant will
          // reconcile them against the committed message when it arrives.
          ensureAssistant().insertAdjacentHTML('beforeend',
            '<details class="tool-call"><summary>' + escapeHTML(ev.name) + '</summary>' +
            '<pre><code>' + escapeHTML(ev.arguments) + '</code></pre></details>');
        }
        break;
      case 'tool_result':
        currentAssistant = null;
        currentReasoning = null;
        if (env.tool_call_id) {
          renderedToolResults.add(env.tool_call_id);
        }
        const details = document.createElement('details');
        details.className = 'tool-result';
        details.innerHTML = '<summary>tool result: ' + escapeHTML(env.name) + '</summary>' +
                            '<pre><code>' + escapeHTML(env.result) + '</code></pre>';
        chat.appendChild(details);
        break;
      case 'resync':
        // The server closed the stream because we fell too far behind its
        // replay buffer. Reload so the page reconnects with a fresh seq
        // instead of looping forever on the stale `since`.
        location.reload();
        return;
      case 'turn_completed':
        const meta = document.createElement('div');
        meta.className = 'turn-usage';
        meta.innerHTML = '<span class="turn-meta">turn ' + env.turn_id + ': ' + env.input + ' in / ' + env.output + ' out' +
                         (env.error ? ' — error: ' + escapeHTML(env.error) : '') + '</span>';
        chat.appendChild(meta);
        currentAssistant = null;
        currentReasoning = null;
        break;
    }
    // Auto-scroll to the bottom only when the user was already at the bottom;
    // otherwise respect their scroll position while they read earlier content.
    if (wasAtBottom) {
      chat.scrollTop = chat.scrollHeight;
    }
  };

  // After sending a message, clear the input and keep focus. The form only
  // exists when a session is selected (the empty state has none).
  if (form) {
    form.addEventListener('htmx:afterRequest', function() {
      input.value = '';
      input.focus();
    });
  }
})();
</script>
{{end}}
