{{define "content"}}
<div id="app" data-session="{{.Session}}">
	<div id="toast" class="toast" hidden></div>
	<button id="menu-btn" type="button" aria-label="Toggle session list" aria-expanded="false" title="Sessions">&#9776;</button>
	<nav class="sidebar">
		<span class="brand">porter</span>
		{{if .Session}}
		<div id="status" class="status" data-running="{{.Running}}" data-queue="{{.Queue}}">
			<span class="status-dot"></span>
			<span id="status-text">connecting…</span>
		</div>
		{{end}}
		<form class="new-chat" hx-post="/api/sessions" hx-swap="none" hx-on::after-request="onNewChat(event)">
			<button type="submit">+ New chat</button>
			{{/* "Run on" picker: every registered execution host (persistent
			     agents, e.g. the laptop agent) that can provision this chat's
			     execution context. The value rides as the form's "host" field;
			     an empty value creates the chat on the server itself. */}}
			<select id="new-chat-host" name="host" title="Run on" aria-label="Run on">
				<option value="">local</option>
			</select>
			{{/* Sandbox fields (hidden until a host is chosen): a repo makes
			     that host provision this chat in a git worktree on the repo —
			     one branch per chat, so sessions don't trample each other. The
			     repo list is populated from the host's discovered repos; the
			     branch defaults to the repo's current branch. */}}
			<div id="new-chat-sandbox" hidden>
				<input type="text" id="new-chat-repo" name="repo" list="repo-options" placeholder="Repo (worktree sandbox)" title="Local git repo on the host to sandbox this chat in — one worktree per chat" autocomplete="off">
				<datalist id="repo-options"></datalist>
				<input type="text" id="new-chat-branch" name="branch" placeholder="Base branch (optional)" title="Base branch for the sandbox; defaults to the repo's current branch" autocomplete="off">
			</div>
		</form>
		<ul id="session-list" hidden></ul>
		{{/* Archived folder: sessions the user archived, folded below the active
		     list. Collapsed by default; the count in the header stays visible so
		     the folder's contents are discoverable while folded. Rows are plain
		     links — the archive/restore action lives on the chat page (not
		     per-row) to keep the sidebar uncluttered. Chatting with an archived
		     session unarchives it server-side. */}}
		<div id="archived-section" hidden>
			<button type="button" id="archived-toggle" class="archived-toggle" aria-expanded="false">
				<span class="archived-caret" id="archived-caret">&#9656;</span>
				Archived (<span id="archived-count">0</span>)
			</button>
			<ul id="archived-list" hidden></ul>
		</div>
	</nav>
	<div id="sidebar-backdrop"></div>
	<main class="main">
		{{if .Session}}
		{{/* Header row: the current session's archive/restore toggle. Always
		     visible (no hover gate) so the action is discoverable,
		     keyboard-operable, and screen-reader accessible. Archive is purely
		     organizational — history, running turns, and streaming are
		     unaffected; sending a message unarchives. */}}
		<div class="chat-header">
			<button type="button" id="archive-btn" class="archive-btn"
			        data-archived="{{if .Archived}}true{{else}}false{{end}}"
			        aria-pressed="{{if .Archived}}true{{else}}false{{end}}"
			        title="{{if .Archived}}Restore this session to the active list{{else}}Archive this session (chatting with it unarchives){{end}}">
				<span id="archive-btn-label">{{if .Archived}}&#8617; Restore{{else}}&#128452; Archive{{end}}</span>
			</button>
		</div>
		<div class="chat-wrap">
			<div id="chat"
			  hx-get="/api/sessions/{{.Session}}/view"
			  hx-trigger="load"
			  hx-swap="innerHTML">
			</div>
			<button id="follow-btn" type="button" hidden>Follow new output</button>
		</div>
		{{/* Execution provider picker: shows where this session's commands run
		     (the local server or a connected client like the REPL on a laptop)
		     and lets the user switch. Seeded from GET /exec/status on page load
		     (exec_status envelopes are live-only, never replayed), then kept
		     live by exec_status envelopes. */}}
		<div id="exec-bar" class="exec-bar">
			<span class="exec-label">Commands run on</span>
			<button type="button" id="exec-picker-btn" class="exec-picker-btn"
			        aria-haspopup="listbox" aria-expanded="false" title="Choose where commands run">
				<span id="exec-picker-name">local</span>
				<span class="exec-caret">&#9662;</span>
			</button>
			<div id="exec-picker" class="exec-picker" role="listbox" hidden></div>
		</div>
		<div id="sse-processor"
		     hx-ext="sse"
		     sse-connect="/api/sessions/{{.Session}}/stream?since={{.Seq}}"
		     sse-swap="message_committed,llm,tool_started,tool_result,tool_result_delta,tool_cancelled,turn_completed,exec_status"
		     hx-swap="none"
		     hx-on:htmx:sse-message="sseMessage(event)"
		     hx-on:htmx:sse-open="onSSEOpen()"
		     hx-on:htmx:sse-error="onSSEError()">
		</div>
		<form hx-post="/api/sessions/{{.Session}}/messages"
		      hx-target="#chat"
		      hx-swap="none"
		      class="msg-form">
			<input type="text" name="content" placeholder="Type a message…" autocomplete="off" autofocus>
			{{/* Stop button: aborts the running agent loop (model stream + any
			     running tool) and ends the turn with a stopped marker. type="button"
			     so it never submits the form. Visible only while a turn is running
			     (JS toggles hidden, seeded by the page-load Running flag). */}}
			<button type="button" id="stop-btn" class="stop-btn" hidden>Stop</button>
			<button type="submit">Send</button>
		</form>
		{{/* Session total below the input box: seeded at page render from the
		     session's accumulated completed-turn usage, then updated in place by
		     the turn_completed SSE handler from the marker's authoritative
		     totals. Hidden until the session has any usage. */}}
		<div class="session-total" id="session-total" {{if and (eq .TotalCached 0) (eq .TotalUncached 0) (eq .TotalOutput 0)}}hidden{{end}}>{{tokenLine .TotalCached .TotalUncached .TotalOutput}}</div>
		{{else}}
		<div class="empty-state">
			<p>No session selected.</p>
			<p>Start a new chat to begin.</p>
		</div>
		{{end}}
	</main>
</div>
<script>
(function() {
  // New chat button: POST /api/sessions, then follow the freshly created
  // session id to its chat page. All client-side; no server change needed.
  // A Warning on the response (e.g. the chosen execution host couldn't
  // provision) is toasted so the user knows the chat fell back to local.
  window.onNewChat = function(evt) {
    if (evt.detail.xhr.status < 200 || evt.detail.xhr.status >= 300) return;
    try {
      const data = JSON.parse(evt.detail.xhr.responseText);
      if (data.id) window.location = '/?session=' + encodeURIComponent(data.id);
      if (data.warning) showToast(data.warning);
    } catch (e) {}
  };

  // showToast shows a transient status message (used for session-create
  // warnings; the session still opens, so the chat is never blocked).
  function showToast(msg) {
    const t = document.getElementById('toast');
    if (!t) return;
    t.textContent = msg;
    t.hidden = false;
    clearTimeout(showToast.timer);
    showToast.timer = setTimeout(function() { t.hidden = true; }, 8000);
  }

  // --- "Run on" picker (execution hosts) ---
  // The new-chat form's select lists every registered execution host — the
  // persistent agents (e.g. the laptop) that can provision an execution
  // context for a new chat. Choosing one sends host=<id> with the create
  // POST; the server provisions a provider on that host before returning, so
  // the first message runs there. Disconnected hosts are greyed out.
  (function() {
    const sel = document.getElementById('new-chat-host');
    if (!sel) return;
    fetch('/api/hosts').then(function(r) { return r.json(); }).then(function(resp) {
      const hosts = (resp && resp.hosts) || [];
      const byID = {};
      for (const h of hosts) {
        byID[h.id] = h;
        const opt = document.createElement('option');
        opt.value = h.id;
        const ctx = h.context || {};
        let label = h.name || h.id;
        if (ctx.cwd) label += ' @ ' + ctx.cwd;
        opt.textContent = label;
        opt.disabled = !h.connected;
        sel.appendChild(opt);
      }
      if (hosts.length === 0) sel.hidden = true;
      // Selecting a host reveals the sandbox fields and populates the repo
      // suggestions with that host's discovered repos (the repos under the
      // host's home directory). There is deliberately no default: the repo is
      // chosen per chat, and the value is cleared on host switch so a chat
      // never silently runs against the wrong repo. A repo the scan missed
      // can still be typed directly.
      const sandbox = document.getElementById('new-chat-sandbox');
      const repoInput = document.getElementById('new-chat-repo');
      const repoList = document.getElementById('repo-options');
      if (sandbox && repoInput && repoList) {
        sel.addEventListener('change', function() {
          const h = byID[sel.value];
          repoList.innerHTML = '';
          if (!h) { sandbox.hidden = true; return; }
          const repos = (h.context && h.context.repos) || [];
          for (const r of repos) {
            const o = document.createElement('option');
            o.value = r;
            repoList.appendChild(o);
          }
          repoInput.value = '';
          sandbox.hidden = false;
        });
      }
    }).catch(function() {});
  })();

  // --- Sidebar sessions (Step 5) ---
  // The server is the source of truth for which sessions exist: GET /api/sessions
  // returns every session (newest first) with a preview of its first message, and
  // the sidebar renders that. Nothing is kept client-side — the page is fully
  // web-reliant, so every load (and the New chat jump) refetches the list.
  const app = document.getElementById('app');
  const activeSession = app ? app.dataset.session || '' : '';

  function renderSidebar(activeId) {
    const listEl = document.getElementById('session-list');
    const secEl = document.getElementById('archived-section');
    const archList = document.getElementById('archived-list');
    const countEl = document.getElementById('archived-count');
    if (!listEl || !secEl || !archList) return;
    fetch('/api/sessions')
      .then(resp => resp.ok ? resp.json() : null)
      .then(data => {
        if (!data || !Array.isArray(data.sessions)) return;
        // The server returns one flat list; the client folds it: active
        // sessions on top, archived ones under the Archived folder. A session
        // is archived when the server reports a nonzero archived_at.
        const active = [], archived = [];
        for (const s of data.sessions) {
          if (!s || !s.id) continue;
          (s.archived_at ? archived : active).push(s);
        }
        listEl.innerHTML = '';
        for (const s of active) listEl.appendChild(sessionLink(s, activeId));
        listEl.hidden = active.length === 0;

        archList.innerHTML = '';
        for (const s of archived) archList.appendChild(sessionLink(s, activeId));
        secEl.hidden = archived.length === 0;
        if (countEl) countEl.textContent = String(archived.length);
        setArchivedOpen(archivedOpen); // preserve the user's expand/collapse choice
      })
      .catch(function() {}); // page is web-reliant; leave the list empty on failure
  }

  // One sidebar row: a plain link to the session. Rows carry no per-session
  // actions — the archive/restore button lives on the chat page for the
  // current session only, keeping the sidebar uncluttered. Archived rows are
  // dimmed (the .archived class) but stay fully clickable.
  function sessionLink(s, activeId) {
    const li = document.createElement('li');
    li.className = 'session-row';
    const a = document.createElement('a');
    a.href = '/?session=' + encodeURIComponent(s.id);
    a.textContent = s.preview || s.id;
    a.title = s.id;
    a.className = 'session-link' + (s.id === activeId ? ' active' : '') + (s.archived_at ? ' archived' : '');
    li.appendChild(a);
    return li;
  }

  // --- Archived folder ---
  // Collapsed by default on every page load; the header's count keeps the
  // folder discoverable while folded. The open state is kept in memory for
  // the page session, so a re-render (after archiving or unarchiving from the
  // chat page) preserves the user's choice rather than snapping it shut.
  const archivedToggle = document.getElementById('archived-toggle');
  const archivedListEl = document.getElementById('archived-list');
  let archivedOpen = false;
  function setArchivedOpen(open) {
    archivedOpen = !!open;
    if (archivedListEl) archivedListEl.hidden = !archivedOpen;
    if (archivedToggle) {
      archivedToggle.setAttribute('aria-expanded', archivedOpen ? 'true' : 'false');
      const caret = document.getElementById('archived-caret');
      if (caret) caret.textContent = archivedOpen ? '\u25be' : '\u25b8';
    }
  }
  if (archivedToggle) {
    archivedToggle.addEventListener('click', function() {
      setArchivedOpen(archivedListEl ? archivedListEl.hidden : false);
    });
  }
  setArchivedOpen(false);

  // --- Archive / restore the current session ---
  // The single archive action lives here, on the chat page, for the session
  // being viewed. Toggling posts to the server, flips the button in place,
  // and re-renders the sidebar so the session moves between the active list
  // and the Archived folder. Sending a message unarchives server-side; the
  // form handler at the bottom syncs the button back in that case.
  const archiveBtn = document.getElementById('archive-btn');
  function updateArchiveBtn() {
    if (!archiveBtn) return;
    const archived = archiveBtn.dataset.archived === 'true';
    const label = document.getElementById('archive-btn-label');
    if (label) label.textContent = archived ? '\u21a9 Restore' : '\u{1F5C4}\ufe0f Archive';
    archiveBtn.title = archived
      ? 'Restore this session to the active list'
      : 'Archive this session (chatting with it unarchives)';
    archiveBtn.setAttribute('aria-pressed', archived ? 'true' : 'false');
  }
  if (archiveBtn) {
    archiveBtn.addEventListener('click', function() {
      const id = activeSession;
      if (!id) return;
      const archived = archiveBtn.dataset.archived === 'true';
      fetch('/api/sessions/' + encodeURIComponent(id) + (archived ? '/unarchive' : '/archive'), { method: 'POST' })
        .then(resp => {
          if (!resp.ok) return;
          archiveBtn.dataset.archived = archived ? 'false' : 'true';
          updateArchiveBtn();
          renderSidebar(id);
        })
        .catch(function() {});
    });
  }
  updateArchiveBtn();

  // Render the list on load (empty state has no active session). The New chat
  // flow navigates with ?session=, so a fresh load always refetches.
  renderSidebar(activeSession || null);

  // --- Connection / turn status (Step 6) ---
  // The sidebar indicator shows three signals. SSE connection comes from the
  // stream lifecycle (htmx:sse-open / htmx:sse-error; the extension auto-retries
  // with backoff, so a drop shows "disconnected" until it reconnects). Turn
  // running and queue depth come from the server: the page's initial state rides
  // on #status's data attributes (captured at render), then the bus updates it —
  // every user message_committed reports how many turns are queued behind it, and
  // turn_completed clears the running flag.
  const statusEl = document.getElementById('status');
  const statusTextEl = statusEl ? document.getElementById('status-text') : null;
  // null = connecting (before the first open/error); true/false = open/closed.
  let sseConnected = null;
  let turnRunning = statusEl ? statusEl.dataset.running === 'true' : false;
	let queueDepth = statusEl ? (parseInt(statusEl.dataset.queue, 10) || 0) : 0;
	// execProvider is the session's current execution provider, refreshed live
	// by exec_status envelopes (null until the first one arrives).
	let execProvider = null;

  // The Stop button mirrors turnRunning: visible only while a turn is running,
  // disabled + "Stopping…" optimistically while the stop POST is in flight (so
  // it can't be clicked twice), and hidden again when the turn ends — either
  // way, the turn_completed envelope reconciles the authoritative state.
  const stopBtn = document.getElementById('stop-btn');
  let stopInFlight = false;

  function updateStopBtn() {
    if (!stopBtn) return;
    if (!turnRunning) {
      stopBtn.hidden = true;
      stopInFlight = false;
      stopBtn.disabled = false;
      stopBtn.textContent = 'Stop';
      return;
    }
    stopBtn.hidden = false;
    stopBtn.disabled = stopInFlight;
    stopBtn.textContent = stopInFlight ? 'Stopping…' : 'Stop';
  }

  function updateStatus() {
    if (!statusEl) return;
    let text, cls;
    if (sseConnected === null) {
      text = 'connecting…';
      cls = 'status-wait';
    } else if (!sseConnected) {
      text = 'disconnected';
      cls = 'status-err';
    } else if (turnRunning) {
      text = queueDepth > 0 ? 'running · ' + queueDepth + ' queued' : 'running…';
      cls = 'status-run';
    } else if (queueDepth > 0) {
      text = queueDepth + ' queued';
      cls = 'status-run';
    } else {
      // The sidebar shows connection/turn status only; where commands run is
      // the execution picker's job, below the chat.
      text = 'connected';
      cls = 'status-ok';
    }
    statusEl.className = 'status ' + cls;
    if (statusTextEl) statusTextEl.textContent = text;
    // The stop button's visibility tracks the same running signal.
    updateStopBtn();
  }

  updateStatus();

  // --- Execution provider picker ---
  // A bar below the chat shows where the session's commands run (the local
  // server or a connected client like the REPL on a laptop) and lets the user
  // switch. It is seeded from GET /exec/status on page load — exec_status
  // envelopes are live-only, never replayed from history, so a provider that
  // connected before the page loaded must be fetched — then reconciled live
  // from exec_status envelopes via renderExecPicker. Switching posts to
  // /exec/select; the server commits a system notice (so the model sees the
  // change) and broadcasts the authoritative status back.
  const execBar = document.getElementById('exec-bar');
  const execPickerBtn = document.getElementById('exec-picker-btn');
  const execPickerName = document.getElementById('exec-picker-name');
  const execPicker = document.getElementById('exec-picker');

  // execSystemShort trims the parenthetical detail off a reported system
  // ("darwin/arm64 (macOS — BSD userland…)" -> "darwin/arm64").
  function execSystemShort(system) {
    if (!system) return '';
    const i = system.indexOf(' (');
    return i > 0 ? system.slice(0, i) : system;
  }

  // clientDetail renders a provider's "system @ cwd" line for the picker row.
  function clientDetail(c) {
    const ctx = c.context || {};
    const parts = [];
    const sys = execSystemShort(ctx.system);
    if (sys) parts.push(sys);
    if (ctx.cwd) parts.push(ctx.cwd);
    return parts.join(' @ ') || '…';
  }

  // renderExecPicker redraws the picker from an ExecStatus payload: the button
  // names the active provider, and the popover lists every provider (local
  // first, then connected clients) with the active one checked.
  function renderExecPicker(status) {
    if (!execBar || !status) return;
    execProvider = status;
    const clients = Array.isArray(status.clients) ? status.clients : [];
    const activeId = status.active_id || 'local';
    const active = clients.find(function(c) { return c.id === activeId; });
    if (execPickerName) {
      execPickerName.textContent = (active && (active.name || active.id)) || 'local';
    }
    if (!execPicker) return;
    execPicker.innerHTML = '';
    for (const c of clients) {
      const name = c.name || c.id || 'provider';
      const isActive = c.id === activeId;
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'exec-picker-row' + (isActive ? ' active' : '');
      row.setAttribute('role', 'option');
      row.setAttribute('aria-selected', isActive ? 'true' : 'false');
      row.dataset.execId = c.id;
      const nameLine = document.createElement('span');
      nameLine.className = 'row-name';
      const kind = document.createElement('span');
      kind.className = 'row-kind';
      kind.textContent = c.kind || 'remote';
      nameLine.appendChild(kind);
      nameLine.appendChild(document.createTextNode(' ' + name));
      if (isActive) {
        const check = document.createElement('span');
        check.className = 'row-check';
        check.textContent = '✓';
        nameLine.appendChild(check);
      }
      row.appendChild(nameLine);
      const detail = document.createElement('div');
      detail.className = 'row-detail';
      detail.textContent = clientDetail(c);
      row.appendChild(detail);
      row.addEventListener('click', function() { selectExec(c.id); });
      execPicker.appendChild(row);
    }
  }

  // selectExec posts the user's choice to /exec/select and closes the popover.
  // The server's exec_status broadcast re-renders the picker authoritatively.
  function selectExec(id) {
    const sess = app ? app.dataset.session : null;
    if (!sess) return;
    closeExecPicker();
    fetch('/api/sessions/' + encodeURIComponent(sess) + '/exec/select', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: id })
    }).catch(function() {});
  }

  function openExecPicker() {
    if (!execPicker || !execPickerBtn) return;
    execPicker.hidden = false;
    execPickerBtn.setAttribute('aria-expanded', 'true');
  }
  function closeExecPicker() {
    if (!execPicker || !execPickerBtn) return;
    execPicker.hidden = true;
    execPickerBtn.setAttribute('aria-expanded', 'false');
  }
  function toggleExecPicker() {
    if (!execPicker) return;
    if (execPicker.hidden) openExecPicker(); else closeExecPicker();
  }

  if (execPickerBtn) {
    execPickerBtn.addEventListener('click', function(evt) {
      evt.stopPropagation();
      toggleExecPicker();
    });
  }
  // A click outside the bar closes the popover; Escape closes it too.
  document.addEventListener('click', function(evt) {
    if (execBar && !execBar.contains(evt.target)) closeExecPicker();
  });
  document.addEventListener('keydown', function(evt) {
    if (evt.key === 'Escape') closeExecPicker();
  });

  // Seed on load: fetch the current provider status. The button shows "local"
  // until then; exec_status envelopes keep it live afterward.
  if (app && app.dataset.session) {
    fetch('/api/sessions/' + encodeURIComponent(app.dataset.session) + '/exec/status')
      .then(function(resp) { return resp.ok ? resp.json() : null; })
      .then(function(status) { if (status) renderExecPicker(status); })
      .catch(function() {});
  }

  // Stop button: POST to the session's stop endpoint to abort the running
  // turn. The server commits any partial reply (marked interrupted), stops any
  // running tool, and ends the turn with a stopped marker; the turn_completed
  // envelope that follows reconciles the authoritative state.
  if (stopBtn) {
    stopBtn.addEventListener('click', function() {
      const app = document.getElementById('app');
      const sess = app ? app.dataset.session : null;
      if (!sess || !turnRunning || stopInFlight) return;
      stopInFlight = true;
      updateStopBtn();
      fetch('/api/sessions/' + encodeURIComponent(sess) + '/stop', { method: 'POST' })
        .then(function(resp) {
          if (!resp.ok) throw new Error('stop rejected');
        })
        .catch(function() {
          // The request failed (e.g. the turn already finished). Revert to
          // running; whichever terminal envelope arrives next settles the real
          // state.
          if (stopInFlight) {
            stopInFlight = false;
            updateStopBtn();
          }
        });
    });
  }

  // --- Mobile sidebar drawer ---
  // On small screens the sidebar is an off-canvas drawer: the hamburger opens
  // it, the backdrop or Escape closes it. It's a pure CSS transition on #app's
  // sidebar-open class (both the slide and the backdrop are driven by it), so
  // the only state this keeps is the class + aria-expanded.
  const menuBtn = document.getElementById('menu-btn');
  const backdropEl = document.getElementById('sidebar-backdrop');
  function setSidebarOpen(open) {
    if (!app) return;
    app.classList.toggle('sidebar-open', open);
    if (menuBtn) menuBtn.setAttribute('aria-expanded', String(open));
  }
  if (menuBtn) {
    menuBtn.addEventListener('click', function() {
      setSidebarOpen(!(app && app.classList.contains('sidebar-open')));
    });
  }
  if (backdropEl) {
    backdropEl.addEventListener('click', function() { setSidebarOpen(false); });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') setSidebarOpen(false);
  });

  const chat = document.getElementById('chat');
  const form = document.querySelector('.msg-form');
  const input = form ? form.querySelector('input[name="content"]') : null;

  // Track the currently streaming assistant message and reasoning block so
  // deltas can append in place instead of creating new elements each time.
  let currentAssistant = null;
  let currentReasoning = null;

  // toolRuns is the single source of truth for every tool call's state, keyed
  // by the model's tool-call id once known. A run spans the whole lifecycle:
  // streaming the call (name/args), running it (start clock, partial output),
  // and its committed result — the DOM is just a view over this store. While a
  // call is streaming, deltas arrive by index and may not carry the id yet, so
  // the live assistant message's _toolRuns map (see getRunByIndex) tracks those
  // pre-id runs and registers them here under the id once it arrives.
  const toolRuns = new Map();

  // --- Client-side markdown (live streaming) ---
  // Assistant output is markdown, but the server only renders the committed
  // copy (message_html on message_committed, goldmark server-side). While a
  // message streams we render markdown in the browser so the live view isn't
  // plain text; the committed swap in finalizeAssistant stays authoritative.
  // markdown-it with html:false escapes raw HTML instead of emitting it, so
  // prompt-injected markup (<img onerror>, <iframe srcdoc>, ...) can never
  // execute in the live view — the same guarantee goldmark's default renderer
  // gives the committed copy. linkify:true + the task-lists plugin match
  // goldmark's GFM extension.
  const mdText = window.markdownit({ html: false, linkify: true }).use(window.markdownitTaskLists);
  // Reasoning is the model's chain-of-thought: same renderer, but breaks:true
  // preserves its newlines (the server ships reasoning as raw text and the
  // client renders it, so there's no goldmark counterpart to match).
  // Single 100ms timer driving all running tool blocks; cleared when idle.
  let toolTimer = null;
  // Committed messages are replayed by the server whenever the SSE stream
  // reconnects from its original `since` (the url is fixed at page load).
  // Remember which commit seqs we've rendered so a replay doesn't duplicate
  // messages that are already in the DOM.
  const renderedCommits = new Set();
  // Failed turns (turn_completed with an error) are rendered into the chat as
  // an error block; successful turns render their per-turn token totals (the
  // REPL's "(N in, M out tokens)" line). Each outcome is identified by the
  // turn's user-message seq (env.turn_seq), the same identity /view renders as
  // data-turn-seq on load, so the DOM check in turnOutcomeRendered covers both
  // sources. These sets are a backstop for elements that leave the DOM (e.g. a
  // /view innerHTML swap) — the marker replays on SSE reconnect, so we must
  // never draw a turn's outcome twice.
  const renderedTurnErrors = new Set();
  const renderedTurnTokens = new Set();
  const renderedTurnStopped = new Set();

  // A turn's outcome (error block or token line) is rendered once per turn,
  // keyed by the turn's user-message seq. /view renders past outcomes with
  // data-turn-seq on load; live-rendered elements carry the same tag, so one
  // DOM check covers both sources plus SSE reconnect replays.
  function turnOutcomeSet(kind) {
    return kind === 'error' ? renderedTurnErrors : (kind === 'stopped' ? renderedTurnStopped : renderedTurnTokens);
  }
  function turnOutcomeRendered(kind, tseq) {
    if (!tseq) return false;
    if (chat && chat.querySelector('[data-turn-seq="' + tseq + '"]')) return true;
    return turnOutcomeSet(kind).has(tseq);
  }
  function markTurnOutcomeRendered(kind, tseq) {
    if (!tseq) return;
    turnOutcomeSet(kind).add(tseq);
  }

  // --- Reasoning blocks ---
  // Reasoning is collapsed by default to a single no-wrap row showing only the
  // last non-blank line: enough to keep an eye on the live stream of the
  // model's thinking without drowning the answer in it, and a constant one-line
  // height so the block doesn't jitter while deltas stream in. CSS truncates
  // the single collapsed line with a trailing ellipsis via text-overflow
  // (see .reasoning-collapsed). When more than one non-blank line is hidden, a
  // "..." marker row sits above the last line so it is clear there is more
  // reasoning than what is visible. The reasoning block is a plain div (no
  // flex), so the toggle row sits above the reasoning text.
  // The caret + "Reasoning" label at the front is the only interactive part:
  // clicking it (or pressing Enter/Space on it) expands/collapses the full text.
  // The reasoning text itself is plain, selectable text with no click handler,
  // so it behaves like normal content. The complete text is always kept in
  // memory on the element so expanded blocks keep updating live as deltas stream in.
  // --- Scroll modes ---
  // Auto-scroll is on by default and keeps the view pinned to the bottom as
  // new output streams in. The first time the user scrolls away from the
  // bottom, auto-scroll is disabled (one-way: scrolling back down does NOT
  // re-enable it). While disabled, a "Follow new output" button appears when
  // new content streams in; clicking it re-enables auto-scroll.
  let autoScroll = true;
  const followBtn = document.getElementById('follow-btn');

  if (chat) {
    // A user-initiated scroll away from the bottom turns auto-scroll off.
    // Programmatic scrolls to the bottom land at the bottom, so they don't
    // trip this and auto-scroll stays enabled.
    chat.addEventListener('scroll', function() {
      if (!isNearBottom(chat)) {
        autoScroll = false;
      }
    });
    // After the initial /view load (hx-trigger="load") lands, pin to the
    // bottom when in auto-scroll mode. Guarded by autoScroll so a manual-mode
    // form submit can never yank the user back down.
    chat.addEventListener('htmx:afterSwap', function() {
      initReasoningBlocks(chat);
      // A /view innerHTML swap can wipe live blocks appended before history
      // landed (e.g. opening the page mid-run); re-fetch in-flight runs so
      // running tool blocks are restored after every history render.
      fetchRuns();
      if (autoScroll) chat.scrollTop = chat.scrollHeight;
    });
  }

  if (followBtn) {
    followBtn.addEventListener('click', function() {
      autoScroll = true;
      followBtn.hidden = true;
      chat.scrollTop = chat.scrollHeight;
    });
  }

  function escapeHTML(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // tokenLine renders a turn's token usage line. When the provider reported
  // cache hits the input split is shown explicitly; otherwise it's the plain
  // "(N in, M out tokens)" line. Mirrors server tokenLine so live and reload
  // render identically.
  function tokenLine(cached, uncached, output) {
    if (cached > 0) {
      return '(' + cached + ' cached + ' + uncached + ' miss in, ' + output + ' out tokens)';
    }
    return '(' + uncached + ' in, ' + output + ' out tokens)';
  }

  // fmtBytes mirrors the server's reload rendering of a byte count as a short
  // human size ("1.0 MB", "1.5 KB", "512 B").
  function fmtBytes(n) {
    if (n >= 1073741824) return (n / 1073741824).toFixed(1) + ' GB';
    if (n >= 1048576) return (n / 1048576).toFixed(1) + ' MB';
    if (n >= 1024) return (n / 1024).toFixed(1) + ' KB';
    return n + ' B';
  }

  // toolOutputBadge renders the tool-output metadata chip for a tool result's
  // summary, or '' when there is none. Mirrors the /view template badge.
  function toolOutputBadge(to) {
    if (!to) return '';
    if (to.recall) {
      return ' <span class="tool-output-badge" title="read_output window served to the model; the full output stays under the source tool result">recall ' + fmtBytes(to.shown_bytes) + '</span>';
    }
    if (to.truncated) {
      return ' <span class="tool-output-badge" title="This tool result was truncated in the model\'s context; the full output is shown here. Load the middle with read_output.">' + fmtBytes(to.total_bytes) + ' · model saw ' + fmtBytes(to.shown_bytes) + '</span>';
    }
    return '';
  }

  // Returns true if the chat is scrolled to (or within `threshold` px of the
  // bottom. Used to decide whether to auto-follow new content: if the user has
  // scrolled up to read earlier messages, don't yank the view back down.
  function isNearBottom(el, threshold) {
    const t = threshold || 40;
    return el.scrollHeight - el.scrollTop - el.clientHeight <= t;
  }

  // --- Collapsible reasoning ---
  // Build a reasoning element into the collapsible "show last line" block.
  // The full text is stored on the element (el._reasoningFull) and
  // renderReasoning() redraws the visible text from it, so the same element
  // can keep updating in place while reasoning streams in.
  function initReasoning(el, fullText) {
    el._reasoningFull = fullText;
    el._expanded = false;
    el.classList.add('reasoning-inited');
    // Only the caret + "Reasoning" label is interactive. The text span gets no
    // click handler, so it stays selectable and clickable like normal text.
    el.innerHTML = '<span class="reasoning-toggle" role="button" tabindex="0" aria-expanded="false" title="Reasoning - click to expand/collapse">' +
                     '<span class="reasoning-caret">\u25b6</span><span class="reasoning-label">Reasoning</span>' +
                   '</span><span class="reasoning-more">...</span><span class="reasoning-text"></span>';
    const toggle = el.querySelector('.reasoning-toggle');
    toggle.addEventListener('click', function() { toggleReasoning(el); });
    toggle.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleReasoning(el);
      }
    });
    renderReasoning(el);
  }

  // Redraw the visible text from el._reasoningFull according to the current
  // collapsed/expanded state. Collapsed shows only the last non-blank line as a
  // single no-wrap row (CSS handles the ellipsis and truncation), with a "..."
  // marker row above it when more non-blank lines are hidden; expanded renders
  // the whole thing through mdReasoning (markdown, line breaks preserved).
  function renderReasoning(el) {
    const text = el._reasoningFull || '';
    const textEl = el.querySelector('.reasoning-text');
    const moreEl = el.querySelector('.reasoning-more');
    const toggle = el.querySelector('.reasoning-toggle');
    if (el._expanded) {
      el.classList.remove('reasoning-collapsed');
      moreEl.classList.remove('show');
      // Expanded reasoning renders as markdown (mdReasoning, breaks:true so
      // the model's line-oriented chain-of-thought keeps its line breaks).
      // html:false keeps injected markup inert, same as the assistant path.
      textEl.innerHTML = mdReasoning.render(text);
      el.querySelector('.reasoning-caret').textContent = '\u25bc';
      toggle.setAttribute('aria-expanded', 'true');
    } else {
      el.classList.add('reasoning-collapsed');
      // Take only the final non-blank line so the block stays exactly one row
      // tall while the line streams in (blank lines are ignored: a text that
      // ends on a newline collapses to the last real line, not an empty row).
      // textContent keeps it cheap and inherently safe (no escaping needed).
      // The .reasoning-collapsed CSS locks the row to one line and applies a
      // trailing ellipsis via text-overflow; the ellipsis glyph lives only in
      // CSS - JS just feeds it the last line.
      const lines = text.replace(/\r\n/g, '\n').split('\n');
      let i = lines.length - 1;
      while (i > 0 && lines[i].trim() === '') {
        i--;
      }
      const lastLine = lines[i];
      // If any non-blank lines are hidden above, show the "..." marker on its
      // own row so it's clear the block holds more than the one visible line.
      const hasMore = i > 0 && lines.slice(0, i).some(function(l) { return l.trim() !== ''; });
      moreEl.classList.toggle('show', hasMore);
      textEl.textContent = lastLine;
      el.querySelector('.reasoning-caret').textContent = '\u25b6';
      toggle.setAttribute('aria-expanded', 'false');
    }
  }

  function toggleReasoning(el) {
    el._expanded = !el._expanded;
    renderReasoning(el);
  }

  // Server-rendered reasoning blocks arrive from /view as raw text on
  // data-reasoning (so the full text never flashes on screen before JS can
  // collapse it). Hydrate them into the collapsible form; live-streamed
  // blocks are already built by initReasoning, so this only touches the raw
  // ones (identified by the data-reasoning attribute).
  function initReasoningBlocks(root) {
    (root || document).querySelectorAll('.reasoning[data-reasoning]:not(.reasoning-inited)').forEach(function(el) {
      initReasoning(el, el.dataset.reasoning);
      el.removeAttribute('data-reasoning');
    });
  }
  function appendMessage(role, html) {
    const div = document.createElement('div');
    div.className = 'msg msg-' + role;
    div.innerHTML = '<span class="msg-role">' + role + '</span><div class="msg-content">' + html + '</div>';
    chat.appendChild(div);
    return div;
  }

  function ensureAssistant() {
    if (!currentAssistant) {
      currentAssistant = appendMessage('assistant', '');
      currentReasoning = null;
    }
    return currentAssistant.querySelector('.msg-content');
  }

  function ensureReasoning() {
    if (!currentReasoning) {
      currentReasoning = document.createElement('div');
      currentReasoning.className = 'reasoning';
      initReasoning(currentReasoning, '');
      ensureAssistant().before(currentReasoning);
    }
    return currentReasoning;
  }

  // --- Live markdown streaming (segments) ---
  // The live assistant msg-content interleaves markdown text with streaming
  // tool-call blocks, so it can't be one innerHTML redraw without destroying
  // the call blocks. Keep an ordered segment list (text runs + call runs) on
  // the element: each frame we rebuild from it — text segments render through
  // mdText, call segments re-append their live <details> blocks. State lives
  // on the run objects (callEl / _toolRuns), so rebuilds are cheap and the
  // segments survive the redraw untouched.
  function textSegments(el) {
    if (!el._mdSegments) el._mdSegments = [];
    return el._mdSegments;
  }

  function appendTextDelta(el, delta) {
    const segs = textSegments(el);
    const last = segs[segs.length - 1];
    if (last && last.type === 'text') last.text += delta;
    else segs.push({ type: 'text', text: delta });
  }

  function ensureCallSegment(el, run) {
    const segs = textSegments(el);
    for (const seg of segs) {
      if (seg.type === 'call' && seg.run === run) return seg;
    }
    const seg = { type: 'call', run: run };
    segs.push(seg);
    return seg;
  }

  // Coalesce redraws to one per animation frame: an LLM can emit many deltas
  // per frame, and re-parsing the whole buffer each time would be wasteful.
  function scheduleMarkdownRedraw(el) {
    if (el._mdDirty) return;
    el._mdDirty = true;
    el._mdRAF = requestAnimationFrame(function() {
      el._mdDirty = false;
      redrawMarkdown(el);
    });
  }

  function redrawMarkdown(el) {
    const segs = el._mdSegments || [];
    while (el.firstChild) el.removeChild(el.firstChild);
    for (const seg of segs) {
      if (seg.type === 'text') {
        const d = document.createElement('div');
        d.className = 'md-seg';
        d.innerHTML = mdText.render(seg.text);
        el.appendChild(d);
      } else {
        renderCall(seg.run, el);
      }
    }
  }

  function renderToolCalls(calls) {
    if (!calls || calls.length === 0) return '';
    let html = '';
    for (const call of calls) {
      html += '<details class="tool-call"><summary>tool call: ' + escapeHTML(call.function.name) +
              (call.function.arguments ? ' ' + escapeHTML(argsSnippet(call.function.arguments)) : '') + '</summary>' +
              '<pre><code>' + escapeHTML(call.function.arguments) + '</code></pre></details>';
    }
    return html;
  }

  // createRun builds a fresh tool-run entry. State lives here, never on the
  // DOM elements (callEl/resultEl are views derived from this entry). status is
  // the run's lifecycle: streaming (call being typed) -> running (tool_started)
  // -> done (tool_result) or cancelled (tool_cancelled, from the user pressing
  // Cancel). A run is registered in toolRuns under its id once the id is known.
  function createRun(callID, index) {
    const run = {
      callID: callID || '',
      index: index,
      name: '',
      args: '',
      status: 'streaming',
      startedAt: 0,
      finishedAt: 0,
      receivedAt: 0,
      result: '',
      callEl: null,
      resultEl: null,
      lastShown: null,
      // cancelling is set optimistically while a Cancel POST is in flight, so
      // the button reads "Stopping…" and the server's tool_cancelled envelope
      // (or a terminal result) reconciles the authoritative state.
      cancelling: false,
    };
    if (run.callID) toolRuns.set(run.callID, run);
    return run;
  }

  // getRunByIndex returns the run backing a streaming call block. Deltas arrive
  // by index and may not carry the call_id yet (providers send it on the first
  // delta), so each msg-content keeps an index -> run map for the pre-id phase;
  // once a delta or the assembled tool_call carries an id, the run is adopted
  // into the id-keyed toolRuns store so result-side events find the same entry.
  function getRunByIndex(contentEl, index, callID) {
    let byIndex = contentEl._toolRuns;
    if (!byIndex) { contentEl._toolRuns = byIndex = new Map(); }
    let run = byIndex.get(index);
    if (!run) {
      run = createRun(callID, index);
      byIndex.set(index, run);
    }
    if (callID && callID !== run.callID) {
      run.callID = callID;
      toolRuns.set(callID, run);
    }
    return run;
  }

  // getRun returns the run for a result-side event (tool_started, deltas, the
  // terminal result, a committed replay, or fetchRuns), creating it if the call
  // was never seen live. Because the agent only starts a tool after its stream
  // (and the id-bearing tool_call) completes, an existing streaming run is
  // found here — the call and result share one entry.
  function getRun(callID) {
    let run = toolRuns.get(callID);
    if (!run) {
      run = createRun(callID, 0);
      run.status = 'running';
    }
    return run;
  }

  // renderCall redraws the streaming call block from its run state. textContent
  // (not innerHTML) keeps the streaming JSON safe without escaping, same as the
  // reasoning preview. The block lives inside the live assistant msg-content
  // and is recreated from the committed message on finalize.
  function renderCall(run, contentEl) {
    if (!run.callEl) {
      run.callEl = document.createElement('details');
      run.callEl.className = 'tool-call';
      run.callEl.innerHTML = '<summary class="tool-call-name"></summary><pre><code class="tool-call-args"></code></pre>';
    }
    // The summary mirrors the tool-result header (name + args snippet) but with
    // no duration or exit status: this is a request, not a result.
    const summary = 'tool call: ' + (run.name || '') +
                    (run.args ? ' ' + argsSnippet(run.args) : '');
    run.callEl.querySelector('.tool-call-name').textContent = summary;
    run.callEl.querySelector('.tool-call-args').textContent = run.args;
    // Always re-append: redrawMarkdown detaches call blocks when it clears the
    // msg-content, and appendChild on an already-attached node is a cheap
    // no-op move, so this is safe on every path.
    contentEl.appendChild(run.callEl);
  }

  // argsSnippet flattens a tool call's JSON arguments into a short single-line
  // snippet for the result header, so results stay traceable to their calls
  // even when a turn runs several tools.
  function argsSnippet(args) {
    const flat = (args || '').replace(/\s+/g, ' ').trim();
    return flat.length > 60 ? flat.slice(0, 60) + '…' : flat;
  }

  // exitCodeLabel extracts the trailing "exit code: N" line the shell tool
  // appends to its output and returns it in the summary label form
  // ("exit_code: 0"), or '' when the result carries none (e.g. a tool that
  // failed before it started). Mirrors toolExitCode in the server's /view
  // render so live and reload produce identical result summaries.
  function exitCodeLabel(result) {
    const text = (result || '').trim();
    const lines = text.split('\n');
    const last = lines[lines.length - 1].trim();
    const m = /^exit code: (.*)$/.exec(last);
    return m ? 'exit_code: ' + m[1].trim() : '';
  }

  // fmtDur matches the server's reload rendering: tenths below 10s, whole
  // seconds at/above 10s.
  function fmtDur(ms) {
    const s = ms / 1000;
    return s < 10 ? s.toFixed(1) + 's' : Math.round(s) + 's';
  }

  // findToolOwner returns the assistant message that owns the most recent batch
  // of tool calls — the last assistant message that carries a .tool-call block.
  // A result belongs next to the call that requested it, and because the agent
  // runs tools sequentially (each batch's results are committed before the next
  // assistant reply), in-flight results always belong to the latest such
  // message. This works for both the live stream and history after a /view
  // render, so live placement matches reload placement.
  function findToolOwner() {
    const assistants = chat.querySelectorAll('.msg-assistant');
    for (let i = assistants.length - 1; i >= 0; i--) {
      if (assistants[i].querySelector('.tool-call')) return assistants[i];
    }
    return null;
  }

  // insertToolResult places a result block as a sibling immediately after its
  // owning assistant message — and after any earlier results of the same batch
  // — so results render in completion order right under the call, matching the
  // /view history layout. Falls back to appending at the chat root only if no
  // owner is found (e.g. a replay with no live assistant copy).
  function insertToolResult(el) {
    const owner = findToolOwner();
    if (!owner) { chat.appendChild(el); return; }
    let point = owner;
    let nxt = owner.nextElementSibling;
    while (nxt && nxt.classList.contains('tool-result')) {
      point = nxt;
      nxt = nxt.nextElementSibling;
    }
    point.insertAdjacentElement('afterend', el);
  }

  // ensureResult creates the run's result block on first need and returns it.
  // Creating it marks the run as rendered live, which is what the committed
  // role-"tool" replay checks (resultEl != null) so a live run is never
  // double-rendered — replacing the old renderedToolResults set. Runs appear in
  // the order their first event arrives, which — because the agent commits and
  // appends each result as it finishes — is completion order.
  function ensureResult(run) {
    if (!run.resultEl) {
      run.resultEl = document.createElement('details');
      run.resultEl.className = 'tool-result';
      // The summary holds the name/status text plus a Cancel button that is
      // only visible while the run is running. A button inside <summary> is
      // interactive; preventDefault stops its click from toggling the details.
      run.resultEl.innerHTML = '<summary><span class="tool-result-name"></span>' +
        '<button type="button" class="tool-cancel" title="Stop this command">Cancel</button></summary>' +
        '<pre><code class="tool-result-body"></code></pre>';
      insertToolResult(run.resultEl);
      run.resultEl.querySelector('.tool-cancel').addEventListener('click', function(e) {
        e.preventDefault();
        cancelRun(run);
      });
    }
    return run.resultEl;
  }

  // Redraw a tool-result block from its run state: name + args snippet, then
  // the status — a server-derived duration once done, a live elapsed timer
  // while running, "cancelled" when the user aborted the run. textContent keeps
  // the output safe without escaping. The Cancel button is shown only while the
  // run is actually running.
  function renderResult(run) {
    const el = run.resultEl;
    if (!el) return;
    const base = 'tool result: ' + (run.name || '') +
                 (run.args ? ' ' + argsSnippet(run.args) : '');
    let status;
    if (run.status === 'cancelled') {
      // The user stopped this run. No exit code (the process was killed), but
      // the server-derived duration is still useful.
      const dur = (run.finishedAt || 0) - (run.startedAt || 0);
      status = 'cancelled' + (dur > 0 ? ' · ' + fmtDur(dur) : '');
    } else if (run.status === 'done') {
      // The shell tool appends its exit status as the final line of output, so
      // a finished result shows exit_code: N (instead of 'done') plus the
      // server-derived duration.
      const code = exitCodeLabel(run.result);
      const dur = (run.finishedAt || 0) - (run.startedAt || 0);
      status = code;
      if (dur > 0) status = (status ? status + ' · ' : '') + fmtDur(dur);
    } else if (run.receivedAt) {
      // Running: elapsed measured from when this client received tool_started
      // (monotonic and clock-skew free). The final duration shown on done is
      // finished_at - started_at straight from the server.
      status = 'running · ' + fmtDur(Math.max(0, Date.now() - run.receivedAt));
    } else {
      status = 'running…';
    }
    el.querySelector('.tool-result-name').textContent = base + (status ? ' · ' + status : '');
    if (run.toolOutput) {
      el.querySelector('.tool-result-name').insertAdjacentHTML('beforeend', toolOutputBadge(run.toolOutput));
    }
    el.querySelector('.tool-result-body').textContent = run.result;
    const cancelBtn = el.querySelector('.tool-cancel');
    if (cancelBtn) {
      cancelBtn.hidden = run.status !== 'running';
      cancelBtn.disabled = !!run.cancelling;
      cancelBtn.textContent = run.cancelling ? 'Stopping…' : 'Cancel';
    }
  }

  // cancelRun stops a running tool by POSTing to the session's cancel endpoint.
  // The server kills the command (locally via its process group, remotely by
  // signalling the execution client) and ends the turn; the tool_cancelled
  // envelope that follows reconciles the authoritative partial output and
  // clocks. Optimistically switch the button to "Stopping…" so it can't be
  // clicked twice while the request is in flight.
  function cancelRun(run) {
    const app = document.getElementById('app');
    const sess = app ? app.dataset.session : null;
    if (!sess || !run.callID || run.status !== 'running') return;
    run.cancelling = true;
    renderResult(run);
    fetch('/api/sessions/' + encodeURIComponent(sess) + '/cancel/' + encodeURIComponent(run.callID), { method: 'POST' })
      .then(function(resp) {
        // A non-2xx (e.g. 404, the run already finished) is a rejection here
        // because fetch resolves on any status.
        if (!resp.ok) throw new Error('cancel rejected');
      })
      .catch(function() {
        // The request failed (e.g. the run already finished). Revert to running;
        // whichever terminal envelope arrives next settles the real state.
        if (run.cancelling) {
          run.cancelling = false;
          renderResult(run);
        }
      });
  }

  // toolTimerTick updates the elapsed shown on every running block, touching the
  // DOM only when the formatted value changes, and stops the timer when nothing
  // is running anymore.
  function toolTimerTick() {
    let anyRunning = false;
    for (const run of toolRuns.values()) {
      if (run.status !== 'running' || !run.receivedAt) continue;
      const formatted = fmtDur(Math.max(0, Date.now() - run.receivedAt));
      if (formatted !== run.lastShown) {
        run.lastShown = formatted;
        renderResult(run);
      }
      anyRunning = true;
    }
    if (!anyRunning && toolTimer) {
      clearInterval(toolTimer);
      toolTimer = null;
    }
  }

  function startToolTimer() {
    if (!toolTimer) toolTimer = setInterval(toolTimerTick, 100);
  }

  // onSSEOpen fires on every SSE connection (initial connect and every
  // reconnect): mark the stream open, refetch in-flight tool runs (so a client
  // that reconnects mid-run reconstructs running blocks from the server's
  // authoritative state), and refresh the status indicator. Exposed on window
  // because hx-on attribute handlers run in global scope.
  window.onSSEOpen = function() {
    sseConnected = true;
    fetchRuns();
    updateStatus();
  };

  // onSSEError fires whenever the EventSource errors (network drop or server
  // restart); the SSE extension retries with backoff and fires onSSEOpen again
  // once the stream reconnects.
  window.onSSEError = function() {
    sseConnected = false;
    updateStatus();
  };

  // fetchRuns GETs the session's in-flight tool runs and renders each as a
  // running block. getRun dedups by call_id, so a block already live is
  // reconciled (name/args/started clock + authoritative accumulated output)
  // rather than duplicated. Server-accurate elapsed: the run's receivedAt is
  // back-dated by (serverNow - startedAt) from the response, so the timer shows
  // how long the tool has actually been running, not how long since we learned
  // about it.
  function fetchRuns() {
    const app = document.getElementById('app');
    const sess = app ? app.dataset.session : null;
    if (!sess) return;
    fetch('/api/sessions/' + encodeURIComponent(sess) + '/runs')
      .then(resp => resp.ok ? resp.json() : null)
      .then(data => {
        if (!data || !data.runs || data.runs.length === 0) return;
        const now = data.now || Date.now();
        for (const r of data.runs) {
          const run = getRun(r.call_id);
          // Already finished/cancelled on this client, or a Cancel is in
          // flight — don't resurrect a run the user just stopped.
          if (run.status === 'done' || run.status === 'cancelled' || run.cancelling) continue;
          if (r.name) run.name = r.name;
          if (r.arguments) run.args = r.arguments;
          run.startedAt = r.started_at || run.startedAt || 0;
          run.receivedAt = Date.now() - (now - r.started_at);
          // Reconcile the partial output to the server's authoritative
          // accumulated text, filling any deltas missed while disconnected.
          run.result = r.output || '';
          run.status = 'running';
          ensureResult(run);
          renderResult(run);
          startToolTimer();
        }
      });
  }

  function finalizeAssistant(m, html) {
    // Replace the live text with the committed version (server-rendered
    // markdown when supplied) and ensure tool calls are present. html is
    // carried on the message_committed envelope so the committed copy matches
    // exactly what /view renders on reload — single source of truth = goldmark
    // on the server. The fallback only fires when no rendered copy is supplied
    // (e.g. an older server); it renders markdown client-side so it still
    // matches, with html:false keeping injected markup inert.
    const contentHTML = html || mdText.render(m.content || '');
    // Reasoning was already rendered live, chunk by chunk, when it streamed
    // (currentReasoning is set until here). A committed copy that arrives with
    // no live stream (SSE replay after a reconnect, or a reload) carries
    // reasoning on the message itself — render it now so history and the live
    // view never differ.
    const hadLiveReasoning = currentReasoning !== null;
    let div;
    if (currentAssistant) {
      div = currentAssistant;
      // The live msg-content (and its streaming call blocks) is replaced by the
      // committed copy. Detach the runs' callEl refs so they don't point at
      // removed nodes; the committed tool calls are re-rendered statically
      // below. The runs themselves stay in toolRuns — their result blocks live
      // outside the msg-content and keep streaming.
      const content = currentAssistant.querySelector('.msg-content');
      if (content && content._toolRuns) {
        content._toolRuns.forEach(run => { run.callEl = null; });
        content._toolRuns = null;
      }
      // Stop any pending live redraw: the committed copy replaces the streamed
      // render, and a late frame must not rebuild the old segments on top.
      if (content._mdRAF) cancelAnimationFrame(content._mdRAF);
      content._mdDirty = false;
      content._mdSegments = null;
      content.innerHTML = contentHTML;
      // Remove any stale tool-call details so we can re-render from the commit.
      div.querySelectorAll('.tool-call').forEach(el => el.remove());
    } else {
      // No live copy (replay/history): render a fresh element with the full
      // committed content rather than an empty bubble.
      div = appendMessage('assistant', contentHTML);
    }
    if (m.reasoning && !hadLiveReasoning) {
      const r = document.createElement('div');
      r.className = 'reasoning';
      initReasoning(r, m.reasoning);
      div.before(r);
    }
    if (m.tool_calls) {
      div.insertAdjacentHTML('beforeend', renderToolCalls(m.tool_calls));
    }
    currentAssistant = null;
    currentReasoning = null;
  }

  window.sseMessage = function(evt) {
    const env = JSON.parse(evt.detail.data);
    // Track whether this SSE event actually added content to the DOM. If
    // auto-scroll is disabled, new content is what surfaces the "Follow new
    // output" button (there's nothing to follow otherwise).
    let hadNewContent = false;
    switch (env.kind) {
      case 'message_committed':
        const m = env.message;
        // Skip a replayed commit we've already rendered (SSE reconnect replays
        // from the original `since`).
        if (env.seq && renderedCommits.has(env.seq)) break;
        if (env.seq) renderedCommits.add(env.seq);
        if (m.role === 'user') {
          currentAssistant = null;
          currentReasoning = null;
          appendMessage('user', escapeHTML(m.content).replace(/\n/g, '<br>'));
          // A user commit marks the start of its turn; the server reports how
          // many turns are still queued behind this one.
          turnRunning = true;
          queueDepth = env.queue || 0;
          updateStatus();
          hadNewContent = true;
		} else if (m.role === 'system') {
		  // A committed system message (e.g. an execution-provider change
		  // notice) renders as a dim status block, matching /view.
		  currentAssistant = null;
		  currentReasoning = null;
		  const sysDiv = document.createElement('div');
		  sysDiv.className = 'msg msg-system';
		  sysDiv.innerHTML = '<span class="msg-role">exec</span><div class="msg-content">' + escapeHTML(m.content).replace(/\n/g, '<br>') + '</div>';
		  chat.appendChild(sysDiv);
		  hadNewContent = true;
		} else if (m.role === 'assistant') {
          finalizeAssistant(m, env.message_html);
          hadNewContent = true;
        } else if (m.role === 'tool') {
          currentAssistant = null;
          currentReasoning = null;
          // The live/replayed stream already rendered this run when its
          // resultEl exists; only render the committed copy when it arrives
          // alone (replay), which carries no tool name.
          const run = getRun(m.tool_call_id);
          if (run.resultEl) {
            break;
          }
          run.status = m.cancelled ? 'cancelled' : 'done';
          run.result = m.content;
          run.toolOutput = env.tool_output;
          run.resultEl = document.createElement('details');
          run.resultEl.className = 'tool-result';
          const code = exitCodeLabel(m.content);
          const status = m.cancelled ? 'cancelled' : (code ? code : '');
          run.resultEl.innerHTML = '<summary>tool result' + (status ? ' · ' + status : '') + toolOutputBadge(run.toolOutput) + '</summary><pre><code>' + escapeHTML(m.content).replace(/\n/g, '<br>') + '</code></pre>';
          // Position the replayed result right after its owning assistant
          // message, matching /view's history layout (live placement already
          // does this via insertToolResult).
          insertToolResult(run.resultEl);
          hadNewContent = true;
        }
        break;
      case 'llm':
        const ev = env.event;
        if (!ev) break;
        if (ev.type === 'message_delta') {
          // Accumulate the raw markdown and redraw through mdText once per
          // frame, so the live view shows styled markdown (headings, code,
          // lists) instead of plain text. The committed copy rendered by the
          // server (finalizeAssistant) remains the authoritative end state.
          const contentEl = ensureAssistant();
          appendTextDelta(contentEl, ev.delta);
          scheduleMarkdownRedraw(contentEl);
          hadNewContent = true;
        } else if (ev.type === 'reasoning_delta') {
          // Accumulate the raw text and redraw: collapsed shows the live last line,
          // expanded shows the full stream growing in place.
          const r = ensureReasoning();
          r._reasoningFull = (r._reasoningFull || '') + ev.reasoning;
          renderReasoning(r);
          hadNewContent = true;
        } else if (ev.type === 'tool_call') {
          // The assembled tool call arrives once the stream ends. It may follow
          // a series of tool_call_delta events that already rendered the block
          // live; getRunByIndex returns that same run and we finalize it with
          // the authoritative full arguments (reconciling any drift, e.g. if
          // deltas were coalesced). finalizeAssistant later reconciles this
          // against the committed message when it arrives.
          const contentEl = ensureAssistant();
          const run = getRunByIndex(contentEl, ev.index || 0, ev.tool_call_id);
          run.name = ev.name;
          run.args = ev.arguments;
          // Record the run as a call segment so the next markdown redraw keeps
          // it (redraw rebuilds the msg-content from segments).
          ensureCallSegment(contentEl, run);
          scheduleMarkdownRedraw(contentEl);
          hadNewContent = true;
        } else if (ev.type === 'tool_call_delta') {
          // Streamed tool-call fragment: accumulate per-index state and redraw
          // in place so the name and JSON arguments fill in live, mirroring how
          // reasoning_delta redraws the reasoning block.
          const contentEl = ensureAssistant();
          const index = ev.index || 0;
          const run = getRunByIndex(contentEl, index, ev.tool_call_id);
          if (ev.name) run.name = ev.name; // last non-empty wins, like the decoder
          run.args += ev.arguments;
          ensureCallSegment(contentEl, run);
          scheduleMarkdownRedraw(contentEl);
          hadNewContent = true;
        }
        break;
      case 'tool_started':
        // The tool began running on the server. Claim its run and start the
        // elapsed timer from the server's start clock; this is what makes the
        // queued -> running transition honest even for a silent tool.
        currentAssistant = null;
        currentReasoning = null;
        const tsRun = getRun(env.tool_call_id);
        if (env.name) tsRun.name = env.name;
        if (env.arguments) tsRun.args = env.arguments;
        tsRun.startedAt = env.started_at || 0;
        tsRun.receivedAt = Date.now();
        tsRun.status = 'running';
        ensureResult(tsRun);
        renderResult(tsRun);
        startToolTimer();
        hadNewContent = true;
        break;
      case 'tool_result':
        // The terminal result arrives once the tool exits. It may follow a
        // series of tool_result_delta chunks that already rendered the block
        // live; getRun returns that same run and we reconcile it with the
        // authoritative full output (covering any dropped deltas, e.g. a
        // subscriber buffer overrun), then mark it done with the server's
        // start/finish clocks so the duration is server-derived.
        currentAssistant = null;
        currentReasoning = null;
        const trRun = getRun(env.tool_call_id);
        if (env.name) trRun.name = env.name;
        if (env.arguments) trRun.args = env.arguments;
        trRun.result = env.result;
        trRun.toolOutput = env.tool_output;
        trRun.status = 'done';
        trRun.startedAt = env.started_at || trRun.startedAt || 0;
        trRun.finishedAt = env.finished_at || 0;
        ensureResult(trRun);
        renderResult(trRun);
        hadNewContent = true;
        break;
      case 'tool_cancelled':
        // The user cancelled this run: reconcile the block to the server's
        // authoritative partial output and clocks, mark it cancelled (terminal,
        // like tool_result), and stop its elapsed timer. The turn ends here.
        currentAssistant = null;
        currentReasoning = null;
        const tcRun = getRun(env.tool_call_id);
        if (env.name) tcRun.name = env.name;
        if (env.arguments) tcRun.args = env.arguments;
        tcRun.result = env.result;
        tcRun.toolOutput = env.tool_output;
        tcRun.status = 'cancelled';
        tcRun.startedAt = env.started_at || tcRun.startedAt || 0;
        tcRun.finishedAt = env.finished_at || 0;
        tcRun.cancelling = false;
        ensureResult(tcRun);
        renderResult(tcRun);
        hadNewContent = true;
        break;
      case 'tool_result_delta':
        // One live chunk of a running tool's output: append to the run so
        // long-running tools render as they produce output. If the
        // tool_started signal was missed (e.g. a dropped envelope), the run
        // still renders, just without a live elapsed timer.
        currentAssistant = null;
        currentReasoning = null;
        const trdRun = getRun(env.tool_call_id);
        if (env.name) trdRun.name = env.name;
        if (env.arguments) trdRun.args = env.arguments;
        trdRun.result += env.delta;
        trdRun.status = trdRun.status === 'done' ? 'done' : 'running';
        ensureResult(trdRun);
        renderResult(trdRun);
        hadNewContent = true;
        break;
		case 'exec_status':
		  // The session's execution provider changed (connected, disconnected,
		  // or swapped in). Re-render the picker from the authoritative
		  // registry; the committed system notice carries the human-readable
		  // text in history.
		  const es = env.exec_status;
		  if (es) {
		    execProvider = es;
		    renderExecPicker(es);
		  }
		  break;
	      case 'resync':
        // The server closed the stream because we fell too far behind its
        // replay buffer. Reload so the page reconnects with a fresh seq
        // instead of looping forever on the stale `since`.
        location.reload();
        return;
      case 'turn_completed':
        currentAssistant = null;
        currentReasoning = null;
        // The running turn finished. Queue depth is left as-is: the server
        // corrects it on the next user message_committed (which reports how
        // many turns remain behind it), and between commits the current value
        // is accurate.
        turnRunning = false;
        // A completed turn's outcome — an error block, or the token usage line
        // — is keyed by the turn's user-message seq (env.turn_seq), the same
        // identity /view renders as data-turn-seq. Dedup against both /view's
        // render and our own so an SSE reconnect replay (the marker replays
        // from the page's fixed `since`) never duplicates it. A turn that
        // failed (e.g. the LLM provider returned a 400 or a rate limit)
        // surfaces its error so a silent failure is never mistaken for a
        // finished turn that just had nothing to say; a successful turn
        // reports its per-turn token totals (cached/uncached input split,
        // mirroring the REPL's "(X cached + Y miss in, M out tokens)" line).
        const tseq = env.turn_seq;
        if (env.stopped && !turnOutcomeRendered('stopped', tseq)) {
          // The user aborted the turn with the Stop button: any partial reply
          // is already committed (marked interrupted), so render a stopped
          // marker — with the partial usage when the provider reported any —
          // in place of the usual token line.
          markTurnOutcomeRendered('stopped', tseq);
          const stopDiv = document.createElement('div');
          stopDiv.className = 'turn-stopped';
          if (tseq) stopDiv.dataset.turnSeq = tseq;
          let label = 'stopped';
          if (env.cached_input > 0 || env.uncached_input > 0 || env.output > 0) {
            label += ' · ' + tokenLine(env.cached_input || 0, env.uncached_input || 0, env.output || 0);
          }
          stopDiv.textContent = label;
          chat.appendChild(stopDiv);
          hadNewContent = true;
        } else if (env.error && !turnOutcomeRendered('error', tseq)) {
          markTurnOutcomeRendered('error', tseq);
          const errDiv = document.createElement('div');
          errDiv.className = 'msg msg-error';
          if (tseq) errDiv.dataset.turnSeq = tseq;
          errDiv.innerHTML = '<span class="msg-role">error</span><div class="msg-content">' +
            escapeHTML(env.error).replace(/\n/g, '<br>') + '</div>';
          chat.appendChild(errDiv);
          hadNewContent = true;
        } else if ((env.cached_input > 0 || env.uncached_input > 0 || env.output > 0) && !turnOutcomeRendered('token', tseq)) {
          markTurnOutcomeRendered('token', tseq);
          const tokDiv = document.createElement('div');
          tokDiv.className = 'token-line';
          if (tseq) tokDiv.dataset.turnSeq = tseq;
          tokDiv.textContent = tokenLine(env.cached_input || 0, env.uncached_input || 0, env.output || 0);
          chat.appendChild(tokDiv);
          hadNewContent = true;
        }
        // The session total below the input box is authoritative on the
        // completion marker: set (never add) from the carried totals, so an
        // SSE reconnect replay or an overlap with the page-load baseline can
        // never double-count. Events are ordered, so the last marker processed
        // always carries the newest total. Not "new content" for scroll
        // purposes — it updates in place outside the chat scroll area.
        const totalEl = document.getElementById('session-total');
        if (totalEl) {
          const hasTotals = env.total_cached_input > 0 || env.total_uncached_input > 0 || env.total_output > 0;
          totalEl.hidden = !hasTotals;
          if (hasTotals) {
            totalEl.textContent = tokenLine(env.total_cached_input || 0, env.total_uncached_input || 0, env.total_output || 0);
          }
        }
        updateStatus();
        hadNewContent = true;
        break;
    }
    // Modes: in auto-scroll mode we keep the view pinned to the bottom as new
    // output arrives. If the user scrolled up, auto-scroll is off and we
    // respect their position, surfacing the follow button so they can resume.
    if (autoScroll) {
      chat.scrollTop = chat.scrollHeight;
    } else if (hadNewContent && followBtn) {
      followBtn.hidden = false;
    }
  };

  // After sending a message, clear the input and keep focus. The form only
  // exists when a session is selected (the empty state has none). Sending a
  // message to an archived session unarchives it server-side; when that
  // happens, flip the page's archive button back to Archive and move the
  // session back into the active sidebar list.
  if (form) {
    form.addEventListener('htmx:afterRequest', function(evt) {
      input.value = '';
      input.focus();
      if (evt.detail && evt.detail.successful && archiveBtn && archiveBtn.dataset.archived === 'true') {
        archiveBtn.dataset.archived = 'false';
        updateArchiveBtn();
        renderSidebar(activeSession);
      }
    });
  }
})();
</script>
{{end}}
