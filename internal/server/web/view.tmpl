{{range .Items}}
	{{if .Message}}
		{{$m := .Message}}
		{{if eq $m.Role "user"}}
			<div class="msg msg-user">
				<span class="msg-role">user</span>
				<div class="msg-content">{{nl2br $m.Content}}</div>
			</div>
		{{else if eq $m.Role "assistant"}}
			{{if $m.Reasoning}}
				<div class="reasoning" data-reasoning="{{$m.Reasoning}}"></div>
			{{end}}
			<div class="msg msg-assistant">
				<span class="msg-role">assistant</span>
				{{if $m.Content}}
					<div class="msg-content">{{renderMarkdown $m.Content}}</div>
				{{end}}
				{{range $m.ToolCalls}}
					<details class="tool-call">
						<summary>tool call: {{.Function.Name}}{{if .Function.Arguments}} {{argsSnippet .Function.Arguments}}{{end}}</summary>
						<pre><code>{{.Function.Arguments}}</code></pre>
					</details>
				{{end}}
			</div>
		{{else if eq $m.Role "system"}}
			<div class="msg msg-system">
				<span class="msg-role">exec</span>
				<div class="msg-content">{{nl2br $m.Content}}</div>
			</div>
		{{else if eq $m.Role "tool"}}
			{{$t := index $.Tools $m.ToolCallID}}
			{{$code := toolExitCode $m.Content}}
			<details class="tool-result">
				<summary title="{{if $t.Name}}{{clock $m.StartedAt}} – {{clock $m.FinishedAt}}{{end}}">tool result: {{$t.Name}}{{if $t.Arguments}} {{argsSnippet $t.Arguments}}{{end}}{{if $m.Cancelled}} · cancelled{{if $m.StartedAt}} · {{dur $m.StartedAt $m.FinishedAt}}{{end}}{{else}}{{if $code}} · {{$code}}{{end}}{{if $m.StartedAt}} · {{dur $m.StartedAt $m.FinishedAt}}{{end}}{{end}}{{if $m.ToolOutput}}{{if $m.ToolOutput.Recall}}<span class="tool-output-badge" title="read_output window served to the model; the full output stays under the source tool result">recall {{fmtBytes $m.ToolOutput.ShownBytes}}</span>{{else if $m.ToolOutput.Truncated}}<span class="tool-output-badge" title="This tool result was truncated in the model's context; the full output is shown here. Load the middle with read_output.">{{fmtBytes $m.ToolOutput.TotalBytes}} · model saw {{fmtBytes $m.ToolOutput.ShownBytes}}</span>{{end}}{{end}}</summary>
				<pre><code>{{nl2br $m.Content}}</code></pre>
			</details>
		{{end}}
	{{else if .Footer}}
		{{if .Footer.Error}}
			<div class="msg msg-error" data-turn-seq="{{.Footer.UserSeq}}">
				<span class="msg-role">error</span>
				<div class="msg-content">{{nl2br .Footer.Error}}</div>
			</div>
		{{else if .Footer.Stopped}}
			<div class="turn-stopped" data-turn-seq="{{.Footer.UserSeq}}">stopped{{if or .Footer.CachedInput .Footer.UncachedInput .Footer.Output}} · {{tokenLine .Footer.CachedInput .Footer.UncachedInput .Footer.Output}}{{end}}</div>
		{{else if or .Footer.CachedInput .Footer.UncachedInput .Footer.Output}}
			<div class="token-line" data-turn-seq="{{.Footer.UserSeq}}">{{tokenLine .Footer.CachedInput .Footer.UncachedInput .Footer.Output}}</div>
		{{end}}
	{{end}}
{{end}}
