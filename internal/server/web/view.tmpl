{{range .Messages}}
	{{if eq .Role "user"}}
		<div class="msg msg-user">
			<span class="msg-role">user</span>
			<div class="msg-content">{{nl2br .Content}}</div>
		</div>
	{{else if eq .Role "assistant"}}
		{{if .Reasoning}}
			<div class="reasoning" data-reasoning="{{.Reasoning}}"></div>
		{{end}}
		<div class="msg msg-assistant">
			<span class="msg-role">assistant</span>
			{{if .Content}}
				<div class="msg-content">{{renderMarkdown .Content}}</div>
			{{end}}
			{{range .ToolCalls}}
				<details class="tool-call">
					<summary>tool call: {{.Function.Name}}{{if .Function.Arguments}} {{argsSnippet .Function.Arguments}}{{end}}</summary>
					<pre><code>{{.Function.Arguments}}</code></pre>
				</details>
			{{end}}
		</div>
	{{else if eq .Role "tool"}}
		{{$t := index $.Tools .ToolCallID}}
		{{$code := toolExitCode .Content}}
		<details class="tool-result">
			<summary title="{{if $t.Name}}{{clock .StartedAt}} – {{clock .FinishedAt}}{{end}}">tool result: {{$t.Name}}{{if $t.Arguments}} {{argsSnippet $t.Arguments}}{{end}}{{if $code}} · {{$code}}{{end}}{{if .StartedAt}} · {{dur .StartedAt .FinishedAt}}{{end}}</summary>
			<pre><code>{{nl2br .Content}}</code></pre>
		</details>
	{{end}}
{{end}}
