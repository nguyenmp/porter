{{range .Items}}
	{{if .Message}}
		{{$m := .Message}}
		{{if eq $m.Role "user"}}
			<div class="msg msg-user"{{if $m.StartedAt}} data-started="{{$m.StartedAt}}"{{end}}>
				<span class="msg-role">user</span>
				<div class="msg-content">{{nl2br $m.Content}}</div>
			</div>
		{{else if eq $m.Role "assistant"}}
			{{if $m.Reasoning}}
				<div class="reasoning" data-reasoning="{{$m.Reasoning}}"></div>
			{{end}}
			<div class="msg msg-assistant"{{if .Seq}} data-msg-seq="{{.Seq}}"{{end}}{{if $m.StartedAt}} data-started="{{$m.StartedAt}}"{{end}}{{if $m.FinishedAt}} data-finished="{{$m.FinishedAt}}"{{end}}>
				<span class="msg-role">assistant</span>
				{{/* Humanize variant tabs: every reply with content shows the tab
				     bar (Original + "+"), so even a short reply can be humanized
				     manually when the auto-pass heuristic doesn't fire. Completed
				     plain-language passes render server-side so a reload shows the
				     same tabs the live stream produced; the Original pane holds
				     the message content, each Humanized N pane one pass. Tab
				     switching and the "+" button are handled by the live client
				     (delegated click handlers in index.tmpl). */}}
				{{if $m.Content}}
					{{$variants := index $.Variants .Seq}}
					<div class="variant-tabs" data-msg-seq="{{.Seq}}">
						<button type="button" class="variant-tab variant-active" data-variant="-1">Original</button>
						{{range $variants}}
							<button type="button" class="variant-tab{{if .Error}} variant-failed{{end}}" data-variant="{{.Index}}"{{if .Error}} title="Humanize pass {{add1 .Index}} failed: {{.Error}}"{{end}}>Humanized {{add1 .Index}}{{if .Error}} · failed{{end}}</button>
						{{end}}
						<button type="button" class="variant-add" title="Humanize again (chained from the latest version)">+</button>
						<div class="variant-panes">
							<div class="variant-pane variant-active" data-variant="-1"><div class="msg-content">{{renderMarkdown $m.Content}}</div></div>
							{{range $variants}}
								<div class="variant-pane" data-variant="{{.Index}}"><div class="msg-content">{{if .Content}}{{renderMarkdown .Content}}{{else}}<em class="variant-error">Humanize pass {{add1 .Index}} failed{{if .Error}}: {{nl2br .Error}}{{end}}</em>{{end}}</div></div>
							{{end}}
						</div>
					</div>
				{{end}}
				{{range $m.ToolCalls}}
					<details class="tool-call">
						<summary>tool call: {{.Function.Name}}{{if .Function.Arguments}} {{argsSnippet .Function.Arguments}}{{end}}</summary>
						<pre><code>{{.Function.Arguments}}</code></pre>
					</details>
				{{end}}
			</div>
		{{else if eq $m.Role "system"}}
			<div class="msg msg-system"{{if $m.StartedAt}} data-started="{{$m.StartedAt}}"{{end}}>
				<span class="msg-role">exec</span>
				<div class="msg-content">{{nl2br $m.Content}}</div>
			</div>
		{{else if eq $m.Role "tool"}}
			{{$t := index $.Tools $m.ToolCallID}}
			{{$code := toolExitCode $m.Content}}
			<details class="tool-result"{{if $m.StartedAt}} data-started="{{$m.StartedAt}}"{{end}}{{if $m.FinishedAt}} data-finished="{{$m.FinishedAt}}"{{end}}{{if $m.Cancelled}} data-cancelled="1"{{end}}>
				<summary title="{{if $t.Name}}{{clock $m.StartedAt}} – {{clock $m.FinishedAt}}{{end}}">tool result: {{$t.Name}}{{if $t.Arguments}} {{argsSnippet $t.Arguments}}{{end}}{{if $m.Cancelled}} · cancelled{{if $m.StartedAt}} · {{dur $m.StartedAt $m.FinishedAt}}{{end}}{{else}}{{if $code}} · {{$code}}{{end}}{{if $m.StartedAt}} · {{dur $m.StartedAt $m.FinishedAt}}{{end}}{{end}}{{if $m.ToolOutput}}{{if $m.ToolOutput.Recall}}<span class="tool-output-badge" title="read_output window served to the model; the full output stays under the source tool result">recall {{fmtBytes $m.ToolOutput.ShownBytes}}</span>{{else if $m.ToolOutput.Truncated}}<span class="tool-output-badge" title="This tool result was truncated in the model's context; the full output is shown here. Load the middle with read_output.">{{fmtBytes $m.ToolOutput.TotalBytes}} · model saw {{fmtBytes $m.ToolOutput.ShownBytes}}</span>{{end}}{{end}}</summary>
				<pre><code>{{nl2br $m.Content}}</code></pre>
			</details>
		{{end}}
	{{else if .Footer}}
		{{if .Footer.Error}}
			<div class="msg msg-error" data-turn-seq="{{.Footer.UserSeq}}">
				<span class="msg-role">error</span>
				<div class="msg-content">{{nl2br .Footer.Error}}</div>
			</div>
		{{else if .Footer.Stopped}}
			<div class="turn-stopped" data-turn-seq="{{.Footer.UserSeq}}">stopped{{if or .Footer.CachedInput .Footer.UncachedInput .Footer.Output}} · {{tokenLine .Footer.CachedInput .Footer.UncachedInput .Footer.Output}}{{end}}</div>
		{{else if or .Footer.CachedInput .Footer.UncachedInput .Footer.Output}}
			<div class="token-line" data-turn-seq="{{.Footer.UserSeq}}">{{tokenLine .Footer.CachedInput .Footer.UncachedInput .Footer.Output}}</div>
		{{end}}
	{{end}}
{{end}}
