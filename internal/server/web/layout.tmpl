<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<title>{{.Title}}</title>
	<script src="https://unpkg.com/htmx.org@2.0.6"></script>
	<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
	<!-- markdown-it renders the live streaming view client-side (the server
	     renders the committed copy with goldmark). Vendored into the embedded
	     web/ dir so the binary stays self-contained; served from /web/*. -->
	<script src="/web/markdown-it.min.js"></script>
	<script src="/web/markdown-it-task-lists.min.js"></script>
	<style>
		html, body { height: 100%; }
		body { font-family: sans-serif; margin: 0; overflow: hidden; }
		#app { display: flex; gap: 1.5rem; align-items: stretch; height: 100vh; height: 100dvh; }
		.sidebar { width: 220px; flex-shrink: 0; padding: 1rem 0 1rem 1rem; overflow-y: auto; }
		.sidebar .brand { display: block; margin-bottom: 0.75rem; font-weight: bold; font-size: 1.1em; }
		/* Connection / turn status indicator */
		.status { display: flex; align-items: center; gap: 0.4rem; margin-bottom: 0.75rem; font-size: 0.8em; color: #666; }
		.status-dot { width: 8px; height: 8px; border-radius: 50%; background: #999; }
		.status-ok .status-dot { background: #2e8b57; }
		.status-run .status-dot { background: #d97706; }
		.status-err .status-dot { background: #d33; }
		.status-wait .status-dot { background: #999; }
		.new-chat { margin-bottom: 0.75rem; }
		.new-chat button { width: 100%; padding: 0.4rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; background: #fff; color: #333; cursor: pointer; }
		.new-chat button:hover { background: #f0f0f0; }
		/* "Run on" picker under the new-chat button: which execution host (if
		   any) provisions this session's context. Populated from GET /api/hosts;
		   hidden when no hosts are registered. */
		.new-chat select, .new-chat input { width: 100%; margin-top: 0.35rem; padding: 0.3rem 0.4rem; border: 1px solid #ccc; border-radius: 4px; background: #fff; color: #333; font-size: 0.85em; box-sizing: border-box; }
		#session-list, #archived-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
		#session-list a, #archived-list a { display: block; padding: 0.35rem 0.5rem; border-radius: 4px; color: #333; text-decoration: none; font-size: 0.9em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		#session-list a:hover, #archived-list a:hover { background: #f0f0f0; }
		#session-list a.active, #archived-list a.active { background: #e0e0e0; font-weight: bold; }
		/* Archived rows read as filed-away: dimmed, but fully clickable —
		   chatting with one unarchives it server-side. */
		#archived-list a { color: #999; }
		#archived-list a:hover { color: #666; }
		#archived-list a.active { color: #333; }
		/* The Archived folder: a collapsible section below the active list,
		   collapsed by default with its count in the header. */
		#archived-section { margin-top: 0.75rem; padding-top: 0.5rem; border-top: 1px solid #eee; }
		.archived-toggle {
			display: flex; align-items: center; gap: 0.3rem;
			width: 100%; padding: 0.3rem 0.5rem; border: none; background: none;
			color: #888; font-size: 0.8em; cursor: pointer; border-radius: 4px; text-align: left;
		}
		.archived-toggle:hover { background: #f5f5f5; }
		.archived-toggle:focus-visible { outline: 2px solid #007bff; outline-offset: 1px; }
		.archived-caret { font-style: normal; font-size: 0.7em; }
		#archived-list { margin-top: 0.25rem; }
		/* Header row above the chat: the current session's archive/restore
		   toggle. Always visible, so the action is discoverable and accessible
		   without a hover gate. */
		.chat-header { display: flex; justify-content: flex-end; padding: 0.4rem 0.75rem; }
		.archive-btn {
			padding: 0.3rem 0.75rem; border: 1px solid #ccc; border-radius: 999px;
			background: #fff; color: #555; font-size: 0.85rem; cursor: pointer;
		}
		.archive-btn:hover { background: #f0f0f0; }
		.archive-btn:focus-visible { outline: 2px solid #007bff; outline-offset: 1px; }
		.main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
		.msg { margin-bottom: 0.75rem; padding: 0.5rem; border-radius: 4px; }
		.msg-user { background: #e8f4fd; }
		.msg-assistant { background: #f5f5f5; }
		.msg-error { background: #fdecea; border: 1px solid #f5c2c2; }
		.msg-error .msg-role { color: #b33; }
		/* System messages (e.g. execution-provider change notices) render as a
		   dim status line so the user sees the environment change without it
		   reading as conversation content. */
		.msg-system { background: transparent; padding: 0.15rem 0.5rem; }
		.msg-system .msg-role { color: #999; font-weight: normal; }
		.msg-system .msg-content { color: #888; font-size: 0.8em; white-space: pre-wrap; }
		/* Per-turn token count rendered after a completed turn (mirrors the
		   REPL's "(N in, M out tokens)" line): small and dim so it reads as
		   metadata under the final message, not part of the conversation. */
		.token-line { font-size: 0.75em; color: #999; margin: 0.15rem 0 0.5rem; padding: 0 0.5rem; }
		/* Session token total rendered below the message form: the same small
		   dim metadata style as the per-turn .token-line, centered as a footer
		   under the input box. No display property is set, so the `hidden`
		   attribute (page-load zero totals, and JS on the first completed turn)
		   still hides it via the UA rule. */
		.session-total { font-size: 0.75em; color: #999; text-align: center; margin: 0 auto; max-width: 1000px; padding: 0 0.5rem 0.75rem; box-sizing: border-box; }
		.msg-role { font-size: 0.8em; font-weight: bold; color: #666; display: block; margin-bottom: 0.25rem; }
		.msg-content { white-space: normal; }
		.tool-call, .tool-result { margin-top: 0.5rem; }
		.tool-call summary, .tool-result summary { cursor: pointer; font-size: 0.85em; color: #555; }
		.tool-call pre, .tool-result pre { background: #1e1e1e; color: #d4d4d4; padding: 0.5rem; border-radius: 4px; overflow-x: auto; }
		.tool-result pre { white-space: pre-wrap; }
		/* The Cancel button on a running tool block: a small right-aligned
		   control inside the result summary. It appears only while the tool is
		   running (JS toggles hidden). */
		.tool-result summary { display: flex; align-items: center; gap: 0.5rem; }
		.tool-result-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		/* The tool-output badge on a tool result summary: shows the full size and
		   how much of it the model saw (or, for read_output results, that the
		   bytes went to the model). A small amber chip so it reads as metadata,
		   not conversation content. */
		.tool-output-badge {
			font-size: 0.78em;
			color: #8a6d3b;
			background: #fdf6e3;
			border: 1px solid #e8d8a0;
			border-radius: 3px;
			padding: 0 0.35em;
			flex-shrink: 0;
			white-space: nowrap;
		}
		.tool-cancel {
			margin-left: auto;
			flex-shrink: 0;
			padding: 0.1rem 0.6rem;
			border: 1px solid #c66;
			border-radius: 4px;
			background: #fff;
			color: #b33;
			font-size: 0.78em;
			cursor: pointer;
		}
		.tool-cancel:hover { background: #fbe9e9; }
		.tool-cancel:disabled { border-color: #ccc; color: #999; background: #f5f5f5; cursor: default; }
		/* Markdown-rendered content */
		.msg-content p { margin: 0.5em 0; }
		.msg-content p:first-child { margin-top: 0; }
		.msg-content p:last-child { margin-bottom: 0; }
		.msg-content table { border-collapse: collapse; margin: 0.5em 0; }
		.msg-content th, .msg-content td { border: 1px solid #ddd; padding: 0.3em 0.6em; text-align: left; }
		.msg-content th { background: #e9e9e9; font-weight: bold; }
		.msg-content pre { background: #1e1e1e; color: #d4d4d4; padding: 0.5rem; border-radius: 4px; overflow-x: auto; }
		.msg-content code { background: #e0e0e0; padding: 0.1em 0.3em; border-radius: 3px; font-size: 0.9em; }
		.msg-content pre code { background: none; padding: 0; }
		.msg-content ul, .msg-content ol { padding-left: 1.5em; }
		.msg-content blockquote { border-left: 3px solid #ccc; margin: 0.5em 0; padding-left: 1em; color: #666; }
		.msg-content h1, .msg-content h2, .msg-content h3 { margin: 0.5em 0 0.3em; }
		/* Live-streamed markdown is rendered per segment (.md-seg) while the
		   committed copy is one contiguous block, so normalize the first/last
		   element margins to match .msg-content p:first-child/:last-child and
		   avoid the text jumping on the final swap. */
		.msg-content .md-seg > :first-child { margin-top: 0; }
		.msg-content .md-seg:last-child > :last-child { margin-bottom: 0; }
		/* GFM task lists (markdown-it-task-lists): drop the bullets and the
		   list indent so checkboxes align like goldmark's committed output. */
		.msg-content ul.contains-task-list { list-style: none; padding-left: 0.2em; }
		/* Message form */
		.msg-form { display: flex; gap: 0.5rem; width: 100%; max-width: 1000px; margin: 0 auto; padding: 1rem 0.5rem; box-sizing: border-box; }
		.msg-form input[type="text"] { flex: 1; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
		.msg-form button { padding: 0.5rem 1rem; border: none; border-radius: 4px; background: #007bff; color: #fff; font-size: 1rem; cursor: pointer; }
		.msg-form button:hover { background: #0056b3; }
		/* The Stop button in the message form: a red control that appears only
		   while a turn is running (JS toggles hidden), so the user can abort the
		   whole agent loop — the model stream and any running tool — not just
		   one tool. Mirrors .tool-cancel styling. */
		.stop-btn {
			padding: 0.5rem 1rem;
			border: 1px solid #c66;
			border-radius: 4px;
			background: #fff;
			color: #b33;
			font-size: 1rem;
			cursor: pointer;
		}
		.stop-btn:hover { background: #fbe9e9; }
		.stop-btn:disabled { border-color: #ccc; color: #999; background: #f5f5f5; cursor: default; }
		/* Stopped-turn marker: the same small dim metadata style as .token-line,
		   rendered after a turn the user aborted with the Stop button. */
		.turn-stopped { font-size: 0.75em; color: #999; margin: 0.15rem 0 0.5rem; padding: 0 0.5rem; }
		.reasoning { color: #888; font-style: italic; margin: 0.25rem 0; padding: 0.25rem 0.5rem; border-left: 2px solid #ccc; }
		.reasoning-toggle { display: inline-flex; align-items: baseline; cursor: pointer; padding: 0 0.3rem; margin: 0 0.4rem 0 -0.3rem; border-radius: 3px; }
		.reasoning-toggle:hover { background: #e9e9e9; }
		.reasoning-toggle:focus-visible { outline: 2px solid #007bff; outline-offset: 1px; }
		.reasoning-caret { font-style: normal; font-size: 0.65rem; margin-right: 0.3rem; color: #aaa; }
		.reasoning-label { font-style: normal; font-size: 0.72rem; letter-spacing: 0.03em; color: #777; }
		.reasoning-text { display: block; }
		/* The "..." marker above the last line when more reasoning lines are
		   hidden. Hidden by default and shown via .show (a class toggle, so the
		   hidden state doesn't fight the `hidden` attribute's display:none).
		   Its own block row sits between the toggle and the collapsed last line. */
		.reasoning-more { display: none; color: #aaa; font-style: normal; font-size: 0.85em; line-height: 1; margin-bottom: 0.15em; }
		.reasoning-more.show { display: block; }
		/* Collapsed: lock the text to exactly one rendered line and show the
		   standard trailing ellipsis via text-overflow. display:block makes the
		   text span a block-level row underneath the toggle (so the toggle sits
		   above the text) and gives text-overflow: ellipsis a width to truncate
		   against. */
		.reasoning.reasoning-collapsed .reasoning-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		.chat-wrap { position: relative; flex: 1; min-height: 0; display: flex; flex-direction: column; }
		/* The chat is the full-width scroll container: it reaches the right edge of
		   the window so the scrollbar sits there, while each inner block is
		   centered and capped at the same readable width as the old body column. */
		#chat { flex: 1; min-height: 0; overflow-y: auto; padding: 1rem 0.5rem; box-sizing: border-box; }
		#chat > * { max-width: 1000px; margin-left: auto; margin-right: auto; }
		#follow-btn {
			position: absolute;
			bottom: 0.75rem;
			left: 50%;
			transform: translateX(-50%);
			padding: 0.4rem 0.9rem;
			border: 1px solid #ccc;
			border-radius: 999px;
			background: #fff;
			color: #333;
			font-size: 0.85rem;
			cursor: pointer;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
			z-index: 10;
		}
		#follow-btn:hover { background: #f0f0f0; }
		/* Execution provider picker: a slim bar between the chat and the
		   message form showing where the session's commands run. The button
		   opens a popover (anchored above the bar so it never covers the
		   input) listing every provider; clicking one switches execution. */
		.exec-bar { position: relative; display: flex; align-items: center; gap: 0.4rem; width: 100%; max-width: 1000px; margin: 0 auto; padding: 0.25rem 0.5rem 0; box-sizing: border-box; font-size: 0.78em; color: #888; }
		.exec-label { flex-shrink: 0; }
		.exec-picker-btn { position: relative; display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.15rem 0.55rem; border: 1px solid #ccc; border-radius: 999px; background: #fff; color: #333; font-size: 0.85em; cursor: pointer; }
		.exec-picker-btn:hover { background: #f0f0f0; }
		.exec-caret { font-size: 0.7em; color: #999; }
		.exec-picker {
			position: absolute;
			bottom: calc(100% + 0.4rem);
			right: 0;
			z-index: 30;
			min-width: 260px;
			max-width: min(320px, calc(100vw - 1rem));
			background: #fff;
			border: 1px solid #ddd;
			border-radius: 8px;
			box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
			padding: 0.25rem;
			max-height: 60vh;
			overflow-y: auto;
		}
		.exec-picker-row { display: block; width: 100%; text-align: left; border: none; background: none; padding: 0.45rem 0.6rem; border-radius: 6px; cursor: pointer; font-size: 0.9em; color: #333; }
		.exec-picker-row:hover { background: #f0f0f0; }
		.exec-picker-row.active { font-weight: bold; }
		.exec-picker-row .row-name { display: flex; align-items: center; gap: 0.4rem; }
		.exec-picker-row .row-kind { font-size: 0.68em; text-transform: uppercase; letter-spacing: 0.04em; color: #999; border: 1px solid #ddd; border-radius: 3px; padding: 0 0.3em; flex-shrink: 0; }
		.exec-picker-row .row-check { margin-left: auto; color: #2e8b57; font-size: 0.9em; }
		.exec-picker-row .row-detail { font-size: 0.8em; color: #888; font-weight: normal; margin-top: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		.empty-state { text-align: center; color: #666; margin-top: 4rem; }
		/* Hamburger that toggles the sidebar drawer on small screens. Hidden on
		   desktop, where the sidebar is always visible. */
		#menu-btn {
			display: none;
			position: fixed;
			top: calc(0.5rem + env(safe-area-inset-top, 0px));
			left: calc(0.5rem + env(safe-area-inset-left, 0px));
			z-index: 40;
			width: 2.75rem;
			height: 2.75rem;
			border: 1px solid #ccc;
			border-radius: 8px;
			background: #fff;
			color: #333;
			font-size: 1.25rem;
			line-height: 1;
			cursor: pointer;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.12);
		}
		#menu-btn:hover { background: #f0f0f0; }
		/* Backdrop behind the open drawer. Hidden everywhere by default; shown
		   only while the drawer is open on small screens, so no JS is needed to
		   show/hide it — toggling .sidebar-open on #app drives both. */
		#sidebar-backdrop {
			display: none;
			position: fixed;
			inset: 0;
			background: rgba(0, 0, 0, 0.4);
			z-index: 20;
		}

		/* --- Mobile layout (below 768px) ---
		   The sidebar becomes an off-canvas drawer: the main chat takes the full
		   width and the session list slides in from the left. All targets grow
		   for touch, the message input stays at 16px (so iOS does not zoom on
		   focus), and safe-area insets keep the menu button, message form, and
		   follow button clear of notches and the home indicator. */
		@media (max-width: 767px) {
			#app { gap: 0; }
			#menu-btn { display: flex; align-items: center; justify-content: center; }
			.sidebar {
				position: fixed;
				top: 0;
				left: 0;
				bottom: 0;
				width: min(280px, 85vw);
				padding: calc(1rem + env(safe-area-inset-top, 0px)) 1rem calc(1rem + env(safe-area-inset-bottom, 0px));
				background: #fff;
				z-index: 30;
				transform: translateX(-100%);
				transition: transform 0.2s ease;
				box-shadow: 2px 0 12px rgba(0, 0, 0, 0.15);
			}
			#app.sidebar-open .sidebar { transform: translateX(0); }
			#app.sidebar-open #sidebar-backdrop { display: block; }

			/* Touch-friendly drawer targets. */
			.new-chat button { padding: 0.7rem 0.75rem; font-size: 1rem; }
			#session-list, #archived-list { gap: 0.125rem; }
			#session-list a, #archived-list a { padding: 0.7rem 0.75rem; font-size: 1rem; }
			.archived-toggle { padding: 0.7rem 0.75rem; font-size: 0.95rem; }
			.archive-btn { padding: 0.6rem 1.1rem; font-size: 1rem; }
			.chat-header { padding: calc(0.5rem + env(safe-area-inset-top, 0px)) 0.5rem 0; }
			.status { font-size: 0.9rem; }
			.status-dot { width: 10px; height: 10px; }

			/* The floating hamburger sits at the top-left, so give the chat a
			   matching top inset so the first message isn't hidden under it. */
			#chat { padding: calc(3.25rem + env(safe-area-inset-top, 0px)) 0.5rem 0.5rem; }
			.msg { padding: 0.6rem; }
			.msg-content { font-size: 1rem; }
			/* Long tables scroll horizontally instead of blowing out the layout. */
			.msg-content table { display: block; overflow-x: auto; }
			/* Bigger tap area for collapsible reasoning. */
			.reasoning-toggle { padding: 0.4rem 0.5rem; margin-left: -0.5rem; }
			/* Message form: taller touch targets, 16px input (no iOS zoom), and
			   bottom safe-area inset so the home indicator never overlaps it. */
			.msg-form { gap: 0.5rem; padding: 0.6rem 0.5rem calc(0.6rem + env(safe-area-inset-bottom, 0px)); }
			.msg-form input[type="text"] { padding: 0.75rem 0.6rem; font-size: 16px; }
			.msg-form button { padding: 0.75rem 1.1rem; font-size: 1rem; }
			.stop-btn { padding: 0.75rem 1.1rem; font-size: 1rem; }
			#follow-btn { bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px)); padding: 0.6rem 1.1rem; }
			/* Execution picker: touch-sized targets, a full-width tap area on
			   the button, and a popover that never covers the input above. */
			.exec-bar { padding: 0.35rem 0.6rem 0; font-size: 0.9rem; }
			.exec-picker-btn { padding: 0.5rem 0.75rem; font-size: 0.95rem; }
			.exec-picker { min-width: min(280px, calc(100vw - 1rem)); max-width: calc(100vw - 1rem); }
			.exec-picker-row { padding: 0.7rem 0.6rem; font-size: 1rem; }
		}
		/* Transient status toast (session-create warnings): fixed to the
		   bottom center, above everything, auto-dismissed by JS. */
		.toast {
			position: fixed;
			bottom: 1rem;
			left: 50%;
			transform: translateX(-50%);
			background: #333;
			color: #fff;
			padding: 0.5rem 1rem;
			border-radius: 4px;
			font-size: 0.9rem;
			z-index: 100;
			max-width: min(480px, 90vw);
		}
	</style>
</head>
<body>
	{{block "content" .}}{{end}}
</body>
</html>
