<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{.Title}}</title>
	<script src="https://unpkg.com/htmx.org@2.0.6"></script>
	<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
	<style>
		body { font-family: sans-serif; max-width: 1000px; margin: 1rem auto; }
		#app { display: flex; gap: 1.5rem; align-items: flex-start; }
		.sidebar { width: 220px; flex-shrink: 0; }
		.sidebar .brand { display: block; margin-bottom: 0.75rem; font-weight: bold; font-size: 1.1em; }
		.new-chat { margin-bottom: 0.75rem; }
		.new-chat button { width: 100%; padding: 0.4rem 0.75rem; border: 1px solid #ccc; border-radius: 4px; background: #fff; color: #333; cursor: pointer; }
		.new-chat button:hover { background: #f0f0f0; }
		#session-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
		#session-list a { display: block; padding: 0.35rem 0.5rem; border-radius: 4px; color: #333; text-decoration: none; font-size: 0.9em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
		#session-list a:hover { background: #f0f0f0; }
		#session-list a.active { background: #e0e0e0; font-weight: bold; }
		.main { flex: 1; min-width: 0; }
		.msg { margin-bottom: 0.75rem; padding: 0.5rem; border-radius: 4px; }
		.msg-user { background: #e8f4fd; }
		.msg-assistant { background: #f5f5f5; }
		.msg-role { font-size: 0.8em; font-weight: bold; color: #666; display: block; margin-bottom: 0.25rem; }
		.msg-content { white-space: normal; }
		.tool-call, .tool-result { margin-top: 0.5rem; }
		.tool-call summary, .tool-result summary { cursor: pointer; font-size: 0.85em; color: #555; }
		.tool-call pre, .tool-result pre { background: #1e1e1e; color: #d4d4d4; padding: 0.5rem; border-radius: 4px; overflow-x: auto; }
		.tool-result pre { white-space: pre-wrap; }
		.turn-usage { margin-top: 1rem; border-top: 1px solid #ddd; padding-top: 0.5rem; }
		.turn-meta { display: block; font-size: 0.8em; color: #888; }
		/* Markdown-rendered content */
		.msg-content p { margin: 0.5em 0; }
		.msg-content p:first-child { margin-top: 0; }
		.msg-content p:last-child { margin-bottom: 0; }
		.msg-content table { border-collapse: collapse; margin: 0.5em 0; }
		.msg-content th, .msg-content td { border: 1px solid #ddd; padding: 0.3em 0.6em; text-align: left; }
		.msg-content th { background: #e9e9e9; font-weight: bold; }
		.msg-content pre { background: #1e1e1e; color: #d4d4d4; padding: 0.5rem; border-radius: 4px; overflow-x: auto; }
		.msg-content code { background: #e0e0e0; padding: 0.1em 0.3em; border-radius: 3px; font-size: 0.9em; }
		.msg-content pre code { background: none; padding: 0; }
		.msg-content ul, .msg-content ol { padding-left: 1.5em; }
		.msg-content blockquote { border-left: 3px solid #ccc; margin: 0.5em 0; padding-left: 1em; color: #666; }
		.msg-content h1, .msg-content h2, .msg-content h3 { margin: 0.5em 0 0.3em; }
		/* Message form */
		.msg-form { display: flex; gap: 0.5rem; margin-top: 1rem; }
		.msg-form input[type="text"] { flex: 1; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; font-size: 1rem; }
		.msg-form button { padding: 0.5rem 1rem; border: none; border-radius: 4px; background: #007bff; color: #fff; font-size: 1rem; cursor: pointer; }
		.msg-form button:hover { background: #0056b3; }
		.reasoning { color: #888; font-style: italic; margin: 0.25rem 0; padding: 0.25rem 0.5rem; border-left: 2px solid #ccc; }
		#chat { max-height: 70vh; overflow-y: auto; }
		.chat-wrap { position: relative; }
		#follow-btn {
			position: absolute;
			bottom: 0.75rem;
			left: 50%;
			transform: translateX(-50%);
			padding: 0.4rem 0.9rem;
			border: 1px solid #ccc;
			border-radius: 999px;
			background: #fff;
			color: #333;
			font-size: 0.85rem;
			cursor: pointer;
			box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
			z-index: 10;
		}
		#follow-btn:hover { background: #f0f0f0; }
		.empty-state { text-align: center; color: #666; margin-top: 4rem; }
	</style>
</head>
<body>
	{{block "content" .}}{{end}}
</body>
</html>
